@model KISMApplicationManagement.Models.UserManagementViewModels.CreateUserViewModel

@using Microsoft.AspNetCore.Identity

@{
    var roles =
        ViewBag.Roles as IEnumerable<IdentityRole>
        ?? Enumerable.Empty<IdentityRole>();
}

<form asp-action="Create"
      asp-controller="UserManagement"
      method="post"
      id="createUserForm"
      novalidate>

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>

    <div class="row g-3">

        <div class="col-md-4">

            <label asp-for="FirstName"
                   class="form-label fw-semibold">
                First Name
            </label>

            <input asp-for="FirstName"
                   class="form-control"
                   maxlength="100"
                   autocomplete="given-name"
                   required />

            <span asp-validation-for="FirstName"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-4">

            <label asp-for="MiddleName"
                   class="form-label fw-semibold">
                Middle Name
            </label>

            <input asp-for="MiddleName"
                   class="form-control"
                   maxlength="100"
                   autocomplete="additional-name" />

            <span asp-validation-for="MiddleName"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-4">

            <label asp-for="LastName"
                   class="form-label fw-semibold">
                Last Name
            </label>

            <input asp-for="LastName"
                   class="form-control"
                   maxlength="100"
                   autocomplete="family-name"
                   required />

            <span asp-validation-for="LastName"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <label asp-for="UserName"
                   class="form-label fw-semibold">
                Username
            </label>

            <input asp-for="UserName"
                   class="form-control"
                   maxlength="50"
                   autocomplete="username"
                   required />

            <span asp-validation-for="UserName"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <label asp-for="Email"
                   class="form-label fw-semibold">
                Email Address
            </label>

            <input asp-for="Email"
                   type="email"
                   class="form-control"
                   maxlength="256"
                   autocomplete="email"
                   required />

            <span asp-validation-for="Email"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <label asp-for="PhoneNumber"
                   class="form-label fw-semibold">
                Phone Number
            </label>

            <input asp-for="PhoneNumber"
                   class="form-control"
                   maxlength="30"
                   autocomplete="tel" />

            <span asp-validation-for="PhoneNumber"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <label asp-for="SelectedRoles"
                   class="form-label fw-semibold">
                Roles
            </label>

            <select asp-for="SelectedRoles"
                    class="form-select kism-role-multiselect"
                    multiple
                    size="5"
                    required
                    aria-describedby="rolesHelp">

                @foreach (var role in roles)
                {
                    <option value="@role.Name">
                        @role.Name
                    </option>
                }

            </select>

            <div id="rolesHelp"
                 class="form-text">
                Select one or more roles.
                Hold Ctrl while clicking to select multiple roles.
            </div>

            <span asp-validation-for="SelectedRoles"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <label asp-for="Password"
                   class="form-label fw-semibold">
                Password
            </label>

            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   required />

            <div class="form-text">
                Minimum 8 characters, including uppercase, lowercase
                and a number.
            </div>

            <span asp-validation-for="Password"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <label asp-for="ConfirmPassword"
                   class="form-label fw-semibold">
                Confirm Password
            </label>

            <input asp-for="ConfirmPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   required />

            <span asp-validation-for="ConfirmPassword"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-12">

            <div class="selected-role-summary mt-2">

                <div class="small text-muted mb-2">
                    Selected Roles
                </div>

                <div id="createSelectedRolesSummary">

                    <span class="text-muted">
                        No roles selected
                    </span>

                </div>

            </div>

        </div>

        <div class="col-12">

            <div class="form-check form-switch">

                <input asp-for="IsActive"
                       class="form-check-input"
                       role="switch"
                       id="createUserIsActive" />

                <label class="form-check-label fw-semibold"
                       for="createUserIsActive">
                    Active User
                </label>

            </div>

            <div class="form-text">
                Inactive users will not be allowed to access the system.
            </div>

        </div>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

        <button type="button"
                class="btn btn-light border"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-kism-primary"
                id="createUserSubmit">

            <i class="bi bi-check-circle me-1"></i>
            Create User

        </button>

    </div>

</form>

<style>

    .kism-role-multiselect {
        min-height: 150px;
        border-color: #dee2e6;
    }

    .kism-role-multiselect:focus {
        border-color: #70461d;
        box-shadow: 0 0 0 0.2rem rgba(216, 0, 184, 0.15);
    }

    .kism-role-multiselect option {
        padding: 8px 10px;
    }

    .kism-role-multiselect option:checked {
        background-color: #70461d;
        color: #ffffff;
    }

    .kism-role-badge {
        background-color: rgba(216, 0, 184, 0.08);
        color: #70461d;
        border: 1px solid rgba(216, 0, 184, 0.18);
        font-weight: 500;
    }

</style>

<script>

    (function () {

        const form =
            $('#createUserForm');

        if (!form.length) {
            return;
        }

        const roleSelect =
            form.find('.kism-role-multiselect');

        const summary =
            form.find('#createSelectedRolesSummary');

        function updateRoleSummary() {

            const selected =
                roleSelect.find('option:selected');

            if (!selected.length) {

                summary.html(`
                    <span class="text-muted">
                        No roles selected
                    </span>
                `);

                return;
            }

            let html = '';

            selected.each(function () {

                const roleName =
                    $('<div>')
                        .text($(this).text())
                        .html();

                html += `
                    <span class="badge kism-role-badge me-1 mb-1">
                        ${roleName}
                    </span>
                `;

            });

            summary.html(html);
        }

        roleSelect.on(
            'change',
            updateRoleSummary
        );

        updateRoleSummary();

        form.on('submit', function (event) {

            event.preventDefault();

            const selectedRoles =
                roleSelect.val();

            if (!selectedRoles
                || !selectedRoles.length) {

                Swal.fire({
                    icon: 'warning',
                    title: 'Select a role',
                    text: 'Please select at least one role.',
                    confirmButtonColor: '#70461d'
                });

                return;
            }

            if (!form[0].checkValidity()) {

                form[0].classList.add('was-validated');

                return;
            }

            const submitButton =
                $('#createUserSubmit');

            submitButton
                .prop('disabled', true)
                .html(`
                    <span class="spinner-border spinner-border-sm me-1">
                    </span>
                    Creating...
                `);

            $.ajax({

                url:
                    form.attr('action'),

                type:
                    'POST',

                data:
                    form.serialize()

            })
            .done(function (response) {

                if (typeof response === 'object'
                    && response.success) {

                    const modalElement =
                        document.getElementById(
                            'createUserModal'
                        );

                    const modal =
                        bootstrap.Modal.getInstance(
                            modalElement
                        );

                    if (modal) {
                        modal.hide();
                    }

                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: response.message,
                        confirmButtonColor: '#70461d'
                    }).then(function () {

                        window.location.reload();

                    });

                    return;
                }

                $('#createUserModalBody')
                    .html(response);

            })
            .fail(function () {

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Unable to create the user.',
                    confirmButtonColor: '#70461d'
                });

                submitButton
                    .prop('disabled', false)
                    .html(`
                        <i class="bi bi-check-circle me-1"></i>
                        Create User
                    `);

            });

        });

    })();

</script>