@model KISMApplicationManagement.Models.UserManagementViewModels.ManageUserRolesViewModel

<form asp-action="ManageRoles"
      asp-controller="UserManagement"
      method="post"
      id="manageUserRolesForm"
      novalidate>

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="UserId" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>

    <div class="text-center mb-4">

        <div class="user-roles-avatar mx-auto mb-3">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h5 class="fw-bold mb-1">
            @Model.UserDisplayName
        </h5>

        <div class="text-muted">
            @@@Model.UserName
        </div>

    </div>

    <div class="mb-3">

        <label asp-for="SelectedRoles"
               class="form-label fw-semibold">
            Assign Roles
        </label>

        <select asp-for="SelectedRoles"
                class="form-select kism-role-multiselect"
                multiple
                size="5"
                aria-describedby="rolesHelp">

            @foreach (var role in Model.AvailableRoles)
            {
                if (role.Selected)
                {
                    <option value="@role.RoleName"
                            selected>
                        @role.RoleName
                    </option>
                }
                else
                {
                    <option value="@role.RoleName">
                        @role.RoleName
                    </option>
                }
            }

        </select>

        <div id="rolesHelp"
             class="form-text">
            Select one or more roles.
            Hold Ctrl while clicking to select multiple roles.
        </div>

        <span asp-validation-for="SelectedRoles"
              class="text-danger small">
        </span>

    </div>

    <div class="selected-role-summary mt-3">

        <div class="small text-muted mb-2">
            Selected Roles
        </div>

        <div id="selectedRolesSummary">

            @if (Model.SelectedRoles.Any())
            {
                foreach (var role in Model.SelectedRoles)
                {
                    <span class="badge kism-role-badge me-1 mb-1">
                        @role
                    </span>
                }
            }
            else
            {
                <span class="text-muted">
                    No roles selected
                </span>
            }

        </div>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

        <button type="button"
                class="btn btn-light border"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-kism-primary"
                id="manageUserRolesSubmit">

            <i class="bi bi-check-circle me-1"></i>
            Save Roles

        </button>

    </div>

</form>

<style>

    .user-roles-avatar {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(216, 0, 184, 0.10);
        color: #d800b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
    }

    .kism-role-multiselect {
        min-height: 150px;
        border-color: #dee2e6;
    }

    .kism-role-multiselect:focus {
        border-color: #d800b8;
        box-shadow: 0 0 0 0.2rem rgba(216, 0, 184, 0.15);
    }

    .kism-role-multiselect option {
        padding: 8px 10px;
    }

    .kism-role-multiselect option:checked {
        background-color: #d800b8;
        color: #ffffff;
    }

    .kism-role-badge {
        background-color: rgba(216, 0, 184, 0.08);
        color: #d800b8;
        border: 1px solid rgba(216, 0, 184, 0.18);
        font-weight: 500;
    }

</style>

<script>

    (function () {

        const form =
            $('#manageUserRolesForm');

        if (!form.length) {
            return;
        }

        const roleSelect =
            form.find('.kism-role-multiselect');

        const summary =
            form.find('#selectedRolesSummary');

        function updateRoleSummary() {

            const selected =
                roleSelect.find('option:selected');

            if (!selected.length) {

                summary.html(`
                    <span class="text-muted">
                        No roles selected
                    </span>
                `);

                return;
            }

            let html = '';

            selected.each(function () {

                const roleName =
                    $('<div>')
                        .text($(this).text())
                        .html();

                html += `
                    <span class="badge kism-role-badge me-1 mb-1">
                        ${roleName}
                    </span>
                `;

            });

            summary.html(html);
        }

        roleSelect.on(
            'change',
            updateRoleSummary
        );

        updateRoleSummary();

        form.on('submit', function (event) {

            event.preventDefault();

            const selectedRoles =
                roleSelect.val();

            if (!selectedRoles
                || !selectedRoles.length) {

                Swal.fire({
                    icon: 'warning',
                    title: 'Select a role',
                    text: 'Please select at least one role.',
                    confirmButtonColor: '#d800b8'
                });

                return;
            }

            const submitButton =
                $('#manageUserRolesSubmit');

            submitButton
                .prop('disabled', true)
                .html(`
                    <span class="spinner-border spinner-border-sm me-1">
                    </span>
                    Saving...
                `);

            $.ajax({

                url:
                    form.attr('action'),

                type:
                    'POST',

                data:
                    form.serialize()

            })
            .done(function (response) {

                if (typeof response === 'object'
                    && response.success) {

                    bootstrap.Modal
                        .getInstance(
                            document.getElementById(
                                'manageUserRolesModal'
                            )
                        )
                        .hide();

                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: response.message,
                        confirmButtonColor: '#d800b8'
                    }).then(function () {

                        window.location.reload();

                    });

                    return;
                }

                $('#manageUserRolesModalBody')
                    .html(response);

            })
            .fail(function () {

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Unable to update the user roles.',
                    confirmButtonColor: '#d800b8'
                });

                submitButton
                    .prop('disabled', false)
                    .html(`
                        <i class="bi bi-check-circle me-1"></i>
                        Save Roles
                    `);

            });

        });

    })();

</script>