@model KISMApplicationManagement.Models.UserManagementViewModels.UserDetailsViewModel

<div class="user-details">

    <div class="text-center mb-4">

        <div class="user-details-avatar mx-auto mb-3">
            <i class="bi bi-person"></i>
        </div>

        <h4 class="fw-bold mb-1">
            @Model.FirstName
            @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
            {
                @(" " + Model.MiddleName)
            }
            @(" " + Model.LastName)
        </h4>

        <div class="text-muted">
            @Model.UserName
        </div>

    </div>

    <div class="row g-3">

        <div class="col-md-6">
            <div class="details-item">
                <div class="details-label">Username</div>
                <div class="details-value">@Model.UserName</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="details-item">
                <div class="details-label">Email</div>
                <div class="details-value">@Model.Email</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="details-item">
                <div class="details-label">Phone Number</div>
                <div class="details-value">
                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                        ? "Not provided"
                        : Model.PhoneNumber)
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="details-item">
                <div class="details-label">Email Status</div>
                <div class="details-value">

                    @if (Model.EmailConfirmed)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            Confirmed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                            Not Confirmed
                        </span>
                    }

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="details-item">
                <div class="details-label">Account Status</div>
                <div class="details-value">

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            Inactive
                        </span>
                    }

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="details-item">
                <div class="details-label">Roles</div>
                <div class="details-value">

                    @if (Model.Roles.Any())
                    {
                        foreach (var role in Model.Roles)
                        {
                            <span class="badge kism-role-badge me-1 mb-1">
                                @role
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">
                            No role assigned
                        </span>
                    }

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="details-item">
                <div class="details-label">Created</div>
                <div class="details-value">
                    @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMMM yyyy HH:mm")
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="details-item">
                <div class="details-label">Last Login</div>
                <div class="details-value">

                    @(Model.LastLoginAtUtc.HasValue
                        ? Model.LastLoginAtUtc.Value.ToLocalTime().ToString("dd MMMM yyyy HH:mm")
                        : "Never")

                </div>
            </div>
        </div>

        @if (Model.UpdatedAtUtc.HasValue)
        {
            <div class="col-12">

                <div class="details-item">

                    <div class="details-label">
                        Last Updated
                    </div>

                    <div class="details-value">
                        @Model.UpdatedAtUtc.Value
                            .ToLocalTime()
                            .ToString("dd MMMM yyyy HH:mm")
                    </div>

                </div>

            </div>
        }

    </div>

    <div class="d-flex justify-content-end mt-4 pt-3 border-top">

        <button type="button"
                class="btn btn-light border"
                data-bs-dismiss="modal">
            Close
        </button>

    </div>

</div>

<style>

    .user-details-avatar {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: rgba(216, 0, 184, 0.10);
        color: #70461d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .details-item {
        padding: 14px 16px;
        background: #f8f9fa;
        border: 1px solid #e7e8ef;
        border-radius: 10px;
        height: 100%;
    }

    .details-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #858999;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 5px;
    }

    .details-value {
        color: #30323d;
        font-weight: 500;
        word-break: break-word;
    }

    .kism-role-badge {
        background-color: rgba(216, 0, 184, 0.08);
        color: #70461d;
        border: 1px solid rgba(216, 0, 184, 0.18);
        font-weight: 500;
    }

</style>