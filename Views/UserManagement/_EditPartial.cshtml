@model KISMApplicationManagement.Models.UserManagementViewModels.EditUserViewModel

<form asp-action="Edit"
      asp-controller="UserManagement"
      asp-route-id="@Model.UserId"
      method="post"
      id="editUserForm"
      novalidate>

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="UserId" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>

    <div class="row g-3">

        <div class="col-md-4">

            <label asp-for="FirstName"
                   class="form-label fw-semibold">
                First Name
            </label>

            <input asp-for="FirstName"
                   class="form-control"
                   maxlength="100"
                   required />

            <span asp-validation-for="FirstName"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-4">

            <label asp-for="MiddleName"
                   class="form-label fw-semibold">
                Middle Name
            </label>

            <input asp-for="MiddleName"
                   class="form-control"
                   maxlength="100" />

            <span asp-validation-for="MiddleName"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-4">

            <label asp-for="LastName"
                   class="form-label fw-semibold">
                Last Name
            </label>

            <input asp-for="LastName"
                   class="form-control"
                   maxlength="100"
                   required />

            <span asp-validation-for="LastName"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <label asp-for="UserName"
                   class="form-label fw-semibold">
                Username
            </label>

            <input asp-for="UserName"
                   class="form-control"
                   maxlength="50"
                   autocomplete="username"
                   required />

            <span asp-validation-for="UserName"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <label asp-for="Email"
                   class="form-label fw-semibold">
                Email Address
            </label>

            <input asp-for="Email"
                   type="email"
                   class="form-control"
                   maxlength="256"
                   autocomplete="email"
                   required />

            <span asp-validation-for="Email"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <label asp-for="PhoneNumber"
                   class="form-label fw-semibold">
                Phone Number
            </label>

            <input asp-for="PhoneNumber"
                   class="form-control"
                   maxlength="30"
                   autocomplete="tel" />

            <span asp-validation-for="PhoneNumber"
                  class="text-danger small">
            </span>

        </div>

        <div class="col-md-6">

            <div class="form-check form-switch mt-4">

                <input asp-for="EmailConfirmed"
                       class="form-check-input"
                       role="switch"
                       id="editUserEmailConfirmed" />

                <label class="form-check-label fw-semibold"
                       for="editUserEmailConfirmed">
                    Email Confirmed
                </label>

            </div>

        </div>

        <div class="col-12">

            <div class="form-check form-switch">

                <input asp-for="IsActive"
                       class="form-check-input"
                       role="switch"
                       id="editUserIsActive" />

                <label class="form-check-label fw-semibold"
                       for="editUserIsActive">
                    Active User
                </label>

                <div class="form-text">
                    Inactive users will not be allowed to access
                    the KISM system.
                </div>

            </div>

        </div>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

        <button type="button"
                class="btn btn-light border"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-kism-primary"
                id="editUserSubmit">

            <i class="bi bi-check-circle me-1"></i>
            Save Changes

        </button>

    </div>

</form>