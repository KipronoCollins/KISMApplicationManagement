                    scales: {
                        x: {
                            stacked: true,

                            grid: {
                                display: false
                            }
                        },

                        y: {
                            stacked: true,

                            beginAtZero: true,

                            grid: {
                                color: gridColor
                            },

                            ticks: {
                                precision: 0
                            }
                        }
                    },

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                usePointStyle: true,

                                padding: 18,

                                boxWidth: 10
                            }
                        },

                        tooltip: commonTooltip
                    }
                }
