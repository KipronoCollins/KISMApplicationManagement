                },

                options: {
                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "65%",

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                usePointStyle: true,

                                padding: 18,

                                boxWidth: 10
                            }
                        },

                        tooltip: commonTooltip
                    }
                }
            });
        }


        // ============================================================
        // COMMITTEE RESULTS BY INTAKE
        // ============================================================

        const committeeResultsCanvas =
            document.getElementById("committeeResultsChart");

        if (committeeResultsCanvas) {

            new Chart(committeeResultsCanvas, {
                type: "bar",

                data: {
                    labels: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
