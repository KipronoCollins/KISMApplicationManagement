                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                usePointStyle: true,

                                padding: 18,

                                boxWidth: 10
                            }
                        },

                        tooltip: commonTooltip
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },

                            ticks: {
                                maxRotation: 45,
                                minRotation: 0
                            }
                        },

                        y: {
                            beginAtZero: true,

                            grid: {
                                color: gridColor
                            },

                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
