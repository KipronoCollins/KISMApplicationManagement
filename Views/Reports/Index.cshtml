        const applicationStatusCanvas =
            document.getElementById("applicationStatusChart");

        if (applicationStatusCanvas) {

            new Chart(applicationStatusCanvas, {
                type: "doughnut",

                data: {
                    labels: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                            applicationStatusLabels)),

                    datasets: [{
                        data: @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                applicationStatusValues)),

                        backgroundColor: [
                            kismMagenta,
                            kismYellow,
                            "#6c757d",
                            "#0d6efd",
                            "#198754",
                            "#dc3545"
                        ],

                        borderColor: "#ffffff",

                        borderWidth: 3,

                        hoverOffset: 8
                    }]
                },

                options: {
                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "65%",

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                usePointStyle: true,

                                padding: 18,

                                boxWidth: 10
                            }
                        },

                        tooltip: commonTooltip
                    }
                }
            });
        }


        // ============================================================
        // APPLICATIONS BY INTAKE
        // ============================================================

        const intakeCanvas =
            document.getElementById("intakeApplicationsChart");

        if (intakeCanvas) {

            new Chart(intakeCanvas, {
                type: "bar",

                data: {
                    labels: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                            intakeLabels)),

                    datasets: [
                        {
                            label: "Total Applications",

                            data: @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                    intakeTotalValues)),

                            backgroundColor: kismMagenta,

                            borderRadius: 6,

                            borderSkipped: false
