@using KISMApplicationManagement.Constants
@using System.Globalization
@model KISMApplicationManagement.Models.ReportViewModels.ReportsDashboardViewModel

@{
    ViewData["Title"] = "Reports Dashboard";

    var selectedIntake = Model.Intakes
        .FirstOrDefault(item => item.IntakeId == Model.IntakeId);

    var filterDescription = selectedIntake == null
        ? "All intakes"
        : $"{selectedIntake.IntakeName}";

    if (Model.FromDate.HasValue || Model.ToDate.HasValue)
    {
        var fromText = Model.FromDate.HasValue
            ? Model.FromDate.Value.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)
            : "Beginning";

        var toText = Model.ToDate.HasValue
            ? Model.ToDate.Value.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)
            : "Today";

        filterDescription += $" · {fromText} – {toText}";
    }

    var applicationStatusLabels = Model.ApplicationStatusChart
        .Select(item => item.Status)
        .ToList();

    var applicationStatusValues = Model.ApplicationStatusChart
        .Select(item => item.Count)
        .ToList();

    var applicationTrendLabels = Model.ApplicationTrend
        .Select(item => item.Label)
        .ToList();

    var applicationTrendValues = Model.ApplicationTrend
        .Select(item => item.Count)
        .ToList();

    var submittedTrendValues = Model.ApplicationTrend
        .Select(item => item.SubmittedCount)
        .ToList();

    var intakeLabels = Model.IntakeApplicationChart
        .Select(item => item.IntakeName)
        .ToList();

    var intakeTotalValues = Model.IntakeApplicationChart
        .Select(item => item.TotalApplications)
        .ToList();

    var intakeDraftValues = Model.IntakeApplicationChart
        .Select(item => item.DraftApplications)
        .ToList();

    var intakePendingValues = Model.IntakeApplicationChart
        .Select(item => item.PendingReviewApplications)
        .ToList();

    var intakeCommitteeValues = Model.IntakeApplicationChart
        .Select(item => item.CommitteeDecisions)
        .ToList();

    var committeeDecisionLabels = Model.CommitteeDecisionChart
        .Select(item => item.Decision)
        .ToList();

    var committeeDecisionValues = Model.CommitteeDecisionChart
        .Select(item => item.Count)
        .ToList();

    var committeeIntakeLabels = Model.CommitteeResultsByIntake
        .Select(item => item.IntakeName)
        .ToList();

    var recommendedByIntakeValues = Model.CommitteeResultsByIntake
        .Select(item => item.RecommendedCount)
        .ToList();

    var notRecommendedByIntakeValues = Model.CommitteeResultsByIntake
        .Select(item => item.NotRecommendedCount)
        .ToList();

    var deferredByIntakeValues = Model.CommitteeResultsByIntake
        .Select(item => item.DeferredCount)
        .ToList();

    var programmeLabels = Model.ProgrammeDemandChart
        .Take(12)
        .Select(item => item.ProgrammeLabel)
        .ToList();

    var programmeTotalValues = Model.ProgrammeDemandChart
        .Take(12)
        .Select(item => item.TotalChoices)
        .ToList();

    var programmeFirstChoiceValues = Model.ProgrammeDemandChart
        .Take(12)
        .Select(item => item.FirstChoiceCount)
        .ToList();

    var programmeSecondChoiceValues = Model.ProgrammeDemandChart
        .Take(12)
        .Select(item => item.SecondChoiceCount)
        .ToList();

    var programmeComparisonLabels = Model.ProgrammeChoiceComparison
        .Take(12)
        .Select(item => item.ProgrammeLabel)
        .ToList();

    var programmeComparisonFirstValues = Model.ProgrammeChoiceComparison
        .Take(12)
        .Select(item => item.FirstChoiceCount)
        .ToList();

    var programmeComparisonSecondValues = Model.ProgrammeChoiceComparison
        .Take(12)
        .Select(item => item.SecondChoiceCount)
        .ToList();
}

<div class="reports-page">

    <!-- ============================================================
         HERO
         ============================================================ -->

    <div class="reports-hero mb-4">
        <div class="reports-hero-content">
            <div class="reports-eyebrow">
                <i class="bi bi-bar-chart-line-fill"></i>
                Management Reporting
            </div>

            <h1 class="reports-title">
                Reports Dashboard
            </h1>

            <p class="reports-subtitle">
                Monitor applications, programme demand, intake performance
                and committee outcomes from one place.
            </p>

            <div class="reports-filter-summary">
                <i class="bi bi-funnel-fill"></i>
                @filterDescription
            </div>
        </div>

        <div class="reports-hero-icon">
            <i class="bi bi-graph-up-arrow"></i>
        </div>
    </div>


    <!-- ============================================================
         FILTERS
         ============================================================ -->

    <div class="kism-card mb-4">
        <div class="kism-card-header">
            <div>
                <div class="section-icon">
                    <i class="bi bi-funnel-fill"></i>
                </div>

                <div class="section-heading">
                    <h5>Report Filters</h5>
                    <span>Filter the dashboard by intake and application date.</span>
                </div>
            </div>

            <a asp-action="Index"
               class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise me-1"></i>
                Clear Filters
            </a>
        </div>

        <div class="card-body">
            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-lg-4 col-md-6">
                    <label for="intakeId" class="form-label">
                        Intake
                    </label>

                    <select id="intakeId"
                            name="intakeId"
                            class="form-select">

                        <option value="">
                            All Intakes
                        </option>

                        @foreach (var intake in Model.Intakes)
                        {
                            <option value="@intake.IntakeId"
                                    selected="@(Model.IntakeId == intake.IntakeId)">
                                @intake.IntakeName
                                @if (!string.IsNullOrWhiteSpace(intake.AcademicYear))
                                {
                                    <text> · @intake.AcademicYear</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(intake.IntakePeriod))
                                {
                                    <text> · @intake.IntakePeriod</text>
                                }
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label for="fromDate" class="form-label">
                        From Date
                    </label>

                    <input type="date"
                           id="fromDate"
                           name="fromDate"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label for="toDate" class="form-label">
                        To Date
                    </label>

                    <input type="date"
                           id="toDate"
                           name="toDate"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <button type="submit"
                            class="btn btn-kism w-100">
                        <i class="bi bi-filter-circle-fill me-1"></i>
                        Apply
                    </button>
                </div>
            </form>
        </div>
    </div>


    <!-- ============================================================
         APPLICATION SUMMARY
         ============================================================ -->

    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon magenta">
                    <i class="bi bi-files"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">
                        Total Applications
                    </span>

                    <strong class="stat-value">
                        @Model.TotalApplications.ToString("N0")
                    </strong>

                    <small>
                        Applications in selected scope
                    </small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon gray">
                    <i class="bi bi-file-earmark"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">
                        Draft Applications
                    </span>

                    <strong class="stat-value">
                        @Model.DraftApplications.ToString("N0")
                    </strong>

                    <small>
                        Not yet submitted
                    </small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon yellow">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">
                        Pending Review
                    </span>

                    <strong class="stat-value">
                        @Model.PendingReviewApplications.ToString("N0")
                    </strong>

                    <small>
                        Awaiting committee process
                    </small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="bi bi-clipboard-check"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">
                        Committee Decisions
                    </span>

                    <strong class="stat-value">
                        @Model.ApplicationsWithCommitteeDecision.ToString("N0")
                    </strong>

                    <small>
                        Finalized committee decisions
                    </small>
                </div>
            </div>
        </div>

    </div>


    <!-- ============================================================
         COMMITTEE SUMMARY
         ============================================================ -->

    <div class="row g-3 mb-4">

        <div class="col-lg-4">
            <div class="decision-card recommended">
                <div class="decision-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <span>
                        Recommended for Admission
                    </span>

                    <strong>
                        @Model.RecommendedApplications.ToString("N0")
                    </strong>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="decision-card not-recommended">
                <div class="decision-icon">
                    <i class="bi bi-x-circle-fill"></i>
                </div>

                <div>
                    <span>
                        Not Recommended
                    </span>

                    <strong>
                        @Model.NotRecommendedApplications.ToString("N0")
                    </strong>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="decision-card deferred">
                <div class="decision-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div>
                    <span>
                        Deferred
                    </span>

                    <strong>
                        @Model.DeferredApplications.ToString("N0")
                    </strong>
                </div>
            </div>
        </div>

    </div>


    <!-- ============================================================
         MAIN CHARTS
         ============================================================ -->

    <div class="row g-4 mb-4">

        <!-- APPLICATION STATUS -->

        <div class="col-xl-5">
            <div class="kism-card chart-card h-100">

                <div class="kism-card-header">
                    <div>
                        <div class="section-icon">
                            <i class="bi bi-pie-chart-fill"></i>
                        </div>

                        <div class="section-heading">
                            <h5>Application Status</h5>
                            <span>
                                Distribution of applications by current status.
                            </span>
                        </div>
                    </div>
                </div>

                <div class="chart-container chart-container-doughnut">
                    @if (Model.ApplicationStatusChart.Any())
                    {
                        <canvas id="applicationStatusChart"></canvas>
                    }
                    else
                    {
                        <div class="chart-empty-state">
                            <i class="bi bi-pie-chart"></i>
                            <span>No application status data available.</span>
                        </div>
                    }
                </div>

            </div>
        </div>


        <!-- APPLICATIONS BY INTAKE -->

        <div class="col-xl-7">
            <div class="kism-card chart-card h-100">

                <div class="kism-card-header">
                    <div>
                        <div class="section-icon">
                            <i class="bi bi-bar-chart-fill"></i>
                        </div>

                        <div class="section-heading">
                            <h5>Applications by Intake</h5>
                            <span>
                                Application volume and workflow position by intake.
                            </span>
                        </div>
                    </div>
                </div>

                <div class="chart-container">
                    @if (Model.IntakeApplicationChart.Any())
                    {
                        <canvas id="intakeApplicationsChart"></canvas>
                    }
                    else
                    {
                        <div class="chart-empty-state">
                            <i class="bi bi-bar-chart"></i>
                            <span>No intake data available.</span>
                        </div>
                    }
                </div>

            </div>
        </div>

    </div>


    <!-- ============================================================
         APPLICATION TREND
         ============================================================ -->

    <div class="kism-card chart-card mb-4">

        <div class="kism-card-header">
            <div>
                <div class="section-icon">
                    <i class="bi bi-graph-up"></i>
                </div>

                <div class="section-heading">
                    <h5>Application Activity Over Time</h5>
                    <span>
                        Applications created and applications with a submission date.
                    </span>
                </div>
            </div>

            <span class="chart-header-badge">
                <i class="bi bi-calendar3 me-1"></i>
                Trend Analysis
            </span>
        </div>

        <div class="chart-container chart-container-trend">
            @if (Model.ApplicationTrend.Any())
            {
                <canvas id="applicationTrendChart"></canvas>
            }
            else
            {
                <div class="chart-empty-state">
                    <i class="bi bi-graph-up"></i>
                    <span>No trend data available.</span>
                </div>
            }
        </div>

    </div>


    <!-- ============================================================
         PROGRAMME DEMAND + COMMITTEE DECISIONS
         ============================================================ -->

    <div class="row g-4 mb-4">

        <!-- PROGRAMME DEMAND -->

        <div class="col-xl-7">
            <div class="kism-card chart-card h-100">

                <div class="kism-card-header">
                    <div>
                        <div class="section-icon">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>

                        <div class="section-heading">
                            <h5>Programme Demand</h5>
                            <span>
                                Top programme choices across applications.
                            </span>
                        </div>
                    </div>

                    <span class="chart-header-badge">
                        Top 12
                    </span>
                </div>

                <div class="chart-container programme-chart-container">
                    @if (Model.ProgrammeDemandChart.Any())
                    {
                        <canvas id="programmeDemandChart"></canvas>
                    }
                    else
                    {
                        <div class="chart-empty-state">
                            <i class="bi bi-mortarboard"></i>
                            <span>No programme demand data available.</span>
                        </div>
                    }
                </div>

            </div>
        </div>


        <!-- COMMITTEE DECISIONS -->

        <div class="col-xl-5">
            <div class="kism-card chart-card h-100">

                <div class="kism-card-header">
                    <div>
                        <div class="section-icon">
                            <i class="bi bi-clipboard-data-fill"></i>
                        </div>

                        <div class="section-heading">
                            <h5>Committee Decisions</h5>
                            <span>
                                Finalized committee decision distribution.
                            </span>
                        </div>
                    </div>
                </div>

                <div class="chart-container chart-container-doughnut">
                    @if (Model.CommitteeDecisionChart.Any(item => item.Count > 0))
                    {
                        <canvas id="committeeDecisionChart"></canvas>
                    }
                    else
                    {
                        <div class="chart-empty-state">
                            <i class="bi bi-clipboard-data"></i>
                            <span>No committee decision data available.</span>
                        </div>
                    }
                </div>

            </div>
        </div>

    </div>


    <!-- ============================================================
         COMMITTEE RESULTS BY INTAKE
         ============================================================ -->

    <div class="kism-card chart-card mb-4">

        <div class="kism-card-header">
            <div>
                <div class="section-icon">
                    <i class="bi bi-bar-chart-steps"></i>
                </div>

                <div class="section-heading">
                    <h5>Committee Results by Intake</h5>
                    <span>
                        Comparison of finalized committee outcomes across intakes.
                    </span>
                </div>
            </div>

            <span class="chart-header-badge">
                Finalized Results
            </span>
        </div>

        <div class="chart-container chart-container-large">
            @if (Model.CommitteeResultsByIntake.Any())
            {
                <canvas id="committeeResultsChart"></canvas>
            }
            else
            {
                <div class="chart-empty-state">
                    <i class="bi bi-bar-chart-steps"></i>
                    <span>No finalized committee results available.</span>
                </div>
            }
        </div>

    </div>


    <!-- ============================================================
         FIRST CHOICE VS SECOND CHOICE
         ============================================================ -->

    <div class="kism-card chart-card mb-4">

        <div class="kism-card-header">
            <div>
                <div class="section-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>

                <div class="section-heading">
                    <h5>Programme Choice Analysis</h5>
                    <span>
                        First-choice versus second-choice demand.
                    </span>
                </div>
            </div>

            <span class="chart-header-badge">
                Top 12 Programmes
            </span>
        </div>

        <div class="chart-container chart-container-large">
            @if (Model.ProgrammeChoiceComparison.Any())
            {
                <canvas id="programmeChoiceComparisonChart"></canvas>
            }
            else
            {
                <div class="chart-empty-state">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>No programme choice data available.</span>
                </div>
            }
        </div>

    </div>


    <!-- ============================================================
         APPLICATION STATUS DETAIL
         ============================================================ -->

    <div class="kism-card mb-4">

        <div class="kism-card-header">
            <div>
                <div class="section-icon">
                    <i class="bi bi-list-check"></i>
                </div>

                <div class="section-heading">
                    <h5>Application Status Breakdown</h5>
                    <span>
                        Detailed numerical breakdown of application statuses.
                    </span>
                </div>
            </div>
        </div>

        <div class="card-body">

            @if (Model.StatusSummary.Any())
            {
                @foreach (var status in Model.StatusSummary)
                {
                    var progressClass =
                        status.Status == ApplicationStatuses.Draft
                            ? "status-draft"
                            : status.Status == ApplicationStatuses.PendingReview
                                ? "status-pending"
                                : "status-other";

                    <div class="status-progress mb-4">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <strong>
                                    @status.Status
                                </strong>
                            </div>

                            <div class="status-progress-value">
                                @status.Count.ToString("N0")
                                <span>
                                    (@status.Percentage.ToString("0.0")%)
                                </span>
                            </div>
                        </div>

                        <div class="progress">
                            <div class="progress-bar @progressClass"
                                 role="progressbar"
                                 style="width: @status.Percentage%;"
                                 aria-valuenow="@status.Percentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h6>No Application Data</h6>
                    <p>
                        There are no applications matching the selected filters.
                    </p>
                </div>
            }

        </div>
    </div>


    <!-- ============================================================
         APPLICATIONS BY INTAKE TABLE
         ============================================================ -->

    <div class="kism-card mb-4">

        <div class="kism-card-header">
            <div>
                <div class="section-icon">
                    <i class="bi bi-table"></i>
                </div>

                <div class="section-heading">
                    <h5>Applications by Intake</h5>
                    <span>
                        Detailed intake-level application and committee statistics.
                    </span>
                </div>
            </div>
        </div>

        <div class="table-responsive">

            <table class="table report-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Intake</th>
                        <th>Academic Year</th>
                        <th>Period</th>
                        <th class="text-center">Total</th>
                        <th class="text-center">Draft</th>
                        <th class="text-center">Pending</th>
                        <th class="text-center">Decisions</th>
                        <th class="text-center">Recommended</th>
                        <th class="text-center">Not Recommended</th>
                        <th class="text-center">Deferred</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.IntakeSummary.Any())
                    {
                        foreach (var intake in Model.IntakeSummary)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @intake.IntakeName
                                    </strong>
                                </td>

                                <td>
                                    @intake.AcademicYear
                                </td>

                                <td>
                                    @intake.IntakePeriod
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-total">
                                        @intake.TotalApplications.ToString("N0")
                                    </span>
                                </td>

                                <td class="text-center">
                                    @intake.DraftApplications.ToString("N0")
                                </td>

                                <td class="text-center">
                                    @intake.PendingReviewApplications.ToString("N0")
                                </td>

                                <td class="text-center">
                                    @intake.CommitteeDecisions.ToString("N0")
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-recommended">
                                        @intake.RecommendedApplications.ToString("N0")
                                    </span>
                                </td>

                                <td class="text-center">
                                    @intake.NotRecommendedApplications.ToString("N0")
                                </td>

                                <td class="text-center">
                                    @intake.DeferredApplications.ToString("N0")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10">
                                <div class="empty-state">
                                    <i class="bi bi-inbox"></i>
                                    <h6>No Intake Data</h6>
                                    <p>
                                        No applications match the selected filters.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>


    <!-- ============================================================
         RECENT APPLICATIONS
         ============================================================ -->

    <div class="kism-card">

        <div class="kism-card-header">
            <div>
                <div class="section-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div class="section-heading">
                    <h5>Recent Applications</h5>
                    <span>
                        The latest applications within the selected reporting scope.
                    </span>
                </div>
            </div>
        </div>

        <div class="table-responsive">

            <table class="table report-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Application</th>
                        <th>Applicant</th>
                        <th>Intake</th>
                        <th>First Choice</th>
                        <th>Second Choice</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.RecentApplications.Any())
                    {
                        foreach (var application in Model.RecentApplications)
                        {
                            var statusClass =
                                application.Status == ApplicationStatuses.Draft
                                    ? "draft"
                                    : application.Status == ApplicationStatuses.PendingReview
                                        ? "pending"
                                        : "other";

                            <tr>

                                <td>
                                    <span class="application-number">
                                        @application.ApplicationNumber
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        @application.ApplicantName
                                    </strong>
                                </td>

                                <td>
                                    @application.IntakeName
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(application.FirstChoice))
                                    {
                                        <span>
                                            @application.FirstChoice
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(application.SecondChoice))
                                    {
                                        <span>
                                            @application.SecondChoice
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="status-badge @statusClass">
                                        @application.Status
                                    </span>
                                </td>

                                <td>
                                    <span class="text-muted small">
                                        @application.CreatedAtUtc.ToLocalTime()
                                            .ToString(
                                                "dd MMM yyyy HH:mm",
                                                CultureInfo.InvariantCulture)
                                    </span>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="bi bi-inbox"></i>
