        // ============================================================
        // APPLICATION TREND
        // ============================================================

        const trendCanvas =
            document.getElementById("applicationTrendChart");

        if (trendCanvas) {

            new Chart(trendCanvas, {
                type: "line",

                data: {
                    labels: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
