                        {
                            label: "Submitted",

                            data: @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                    submittedTrendValues)),

                            borderColor: success,

                            backgroundColor:
                                "rgba(25, 135, 84, 0.06)",

                            borderWidth: 2,

                            pointRadius: 2,

                            pointHoverRadius: 5,

                            pointBackgroundColor:
                                success,

                            fill: true,

                            tension: 0.35
                        }
                    ]
                },

                options: {
                    responsive: true,

                    maintainAspectRatio: false,

                    interaction: {
                        mode: "index",
                        intersect: false
                    },

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                usePointStyle: true,

                                padding: 18,

                                boxWidth: 10
                            }
                        },

                        tooltip: commonTooltip
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },

                            ticks: {
                                maxTicksLimit: 14
                            }
                        },

                        y: {
                            beginAtZero: true,

                            grid: {
                                color: gridColor
                            },

                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        }


        // ============================================================
        // PROGRAMME DEMAND
        // ============================================================

        const programmeCanvas =
            document.getElementById("programmeDemandChart");

        if (programmeCanvas) {

            new Chart(programmeCanvas, {
                type: "bar",

                data: {
                    labels: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                            programmeLabels)),

                    datasets: [
