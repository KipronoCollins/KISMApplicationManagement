                            borderRadius: 6,

                            borderSkipped: false
                        }
                    ]
                },

                options: {
                    indexAxis: "y",

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: false
                        },

                        tooltip: commonTooltip
                    },

                    scales: {
                        x: {
                            beginAtZero: true,

                            grid: {
                                color: gridColor
                            },

                            ticks: {
                                precision: 0
                            }
                        },

                        y: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }


        // ============================================================
        // COMMITTEE DECISIONS DOUGHNUT
        // ============================================================

        const committeeDecisionCanvas =
            document.getElementById("committeeDecisionChart");

        if (committeeDecisionCanvas) {

            new Chart(committeeDecisionCanvas, {
                type: "doughnut",

                data: {
                    labels: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                            committeeDecisionLabels)),

                    datasets: [{
                        data: @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
