                        {
                            label: "Pending Review",

                            data: @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                    intakePendingValues)),

                            backgroundColor: warning,

                            borderRadius: 6,

                            borderSkipped: false
