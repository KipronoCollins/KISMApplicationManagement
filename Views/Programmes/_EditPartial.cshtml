@model KISMApplicationManagement.Models.ProgrammeViewModels.ProgrammeViewModel

<form id="editProgrammeForm"
      asp-controller="Programmes"
      asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="ProgrammeId"
           type="hidden" />


    <div class="modal-header kism-modal-header">

        <div>
            <h5 class="modal-title fw-bold mb-1">
                Edit Programme
            </h5>

            <small>
                Update programme information.
            </small>
        </div>

        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="modal">
        </button>

    </div>


    <div class="modal-body p-4">

        <div class="row g-4">

            <!-- Programme Code -->
            <div class="col-md-4">

                <label asp-for="ProgrammeCode"
                       class="form-label">
                </label>

                <input asp-for="ProgrammeCode"
                       class="form-control"
                       autocomplete="off" />

                <span asp-validation-for="ProgrammeCode"
                      class="text-danger small">
                </span>

            </div>


            <!-- Programme Name -->
            <div class="col-md-8">

                <label asp-for="ProgrammeName"
                       class="form-label">
                </label>

                <input asp-for="ProgrammeName"
                       class="form-control" />

                <span asp-validation-for="ProgrammeName"
                      class="text-danger small">
                </span>

            </div>


            <!-- Award Type -->
            <div class="col-md-6">

                <label asp-for="AwardType"
                       class="form-label">
                </label>

                <select asp-for="AwardType"
                        class="form-select">

                    <option value="Certificate">
                        Certificate
                    </option>

                    <option value="Diploma">
                        Diploma
                    </option>

                </select>

                <span asp-validation-for="AwardType"
                      class="text-danger small">
                </span>

            </div>


            <!-- Duration -->
            <div class="col-md-3">

                <label asp-for="DurationYears"
                       class="form-label">
                </label>

                <input asp-for="DurationYears"
                       type="number"
                       min="1"
                       max="10"
                       class="form-control" />

                <span asp-validation-for="DurationYears"
                      class="text-danger small">
                </span>

            </div>


            <!-- Display Order -->
            <div class="col-md-3">

                <label asp-for="DisplayOrder"
                       class="form-label">
                </label>

                <input asp-for="DisplayOrder"
                       type="number"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="DisplayOrder"
                      class="text-danger small">
                </span>

            </div>


            <!-- Description -->
            <div class="col-12">

                <label asp-for="Description"
                       class="form-label">
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger small">
                </span>

            </div>


            <!-- Active -->
            <div class="col-12">

                <div class="form-check form-switch">

                    <input asp-for="IsActive"
                           class="form-check-input"
                           role="switch" />

                    <label asp-for="IsActive"
                           class="form-check-label fw-semibold">
                    </label>

                </div>

            </div>

        </div>

    </div>


    <div class="modal-footer px-4 py-3">

        <button type="button"
                class="btn btn-light"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                class="btn btn-kism-primary"
                id="updateProgrammeButton">

            <span class="update-programme-content">

                <i class="bi bi-check-circle me-2"></i>

                Save Changes

            </span>

            <span class="update-programme-loading d-none">

                <span class="spinner-border spinner-border-sm me-2"></span>

                Saving...

            </span>

        </button>

    </div>

</form>