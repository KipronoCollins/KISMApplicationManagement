<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>@ViewData["Title"] - KISM Application Management</title>

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<!-- DataTables -->
<link rel="stylesheet"
      href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.min.css" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/responsive/3.0.6/css/responsive.bootstrap5.min.css" />

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

<style>
    :root {
        --kism-primary: #d800b8;
        --kism-primary-dark: #ad0093;
        --kism-accent: #edff0f;
        --kism-background: #f6f7fb;
        --kism-sidebar-width: 280px;
        --kism-sidebar-collapsed-width: 82px;
        --kism-topbar-height: 72px;
        --kism-text: #30323d;
        --kism-muted: #858999;
        --kism-border: #e7e8ef;
    }

    * {
        box-sizing: border-box;
    }

    html {
        font-size: 14px;
        min-height: 100%;
    }

    body {
        margin: 0;
        min-height: 100vh;
        background: var(--kism-background);
        color: var(--kism-text);
        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            Arial,
            sans-serif;
    }

    /* ============================================================
       SIDEBAR
       ============================================================ */

    .kism-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--kism-sidebar-width);
        background: #ffffff;
        border-right: 1px solid var(--kism-border);
        box-shadow: 4px 0 20px rgba(31, 35, 45, 0.06);
        z-index: 1040;
        display: flex;
        flex-direction: column;
        transition:
            width 0.25s ease,
            transform 0.25s ease;
        overflow: hidden;
    }

    .kism-sidebar-brand {
        height: var(--kism-topbar-height);
        min-height: var(--kism-topbar-height);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-bottom: 1px solid var(--kism-border);
        background: #ffffff;
    }

    .kism-sidebar-logo-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        text-decoration: none;
    }

    .kism-sidebar-logo {
        display: block;
        max-width: 170px;
        max-height: 52px;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    .kism-sidebar-content {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 14px 12px 20px;
    }

    .kism-sidebar-content::-webkit-scrollbar {
        width: 5px;
    }

    .kism-sidebar-content::-webkit-scrollbar-thumb {
        background: #d8d9e1;
        border-radius: 10px;
    }

    .kism-sidebar-section {
        margin-bottom: 18px;
    }

    .kism-sidebar-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        margin-bottom: 5px;
        color: var(--kism-muted);
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        white-space: nowrap;
    }

    .kism-sidebar-link {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 43px;
        padding: 10px 12px;
        margin: 2px 0;
        border-radius: 9px;
        color: #555a6c;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .kism-sidebar-link i {
        width: 20px;
        min-width: 20px;
        text-align: center;
        font-size: 1.05rem;
    }

    .kism-sidebar-link:hover {
        background: rgba(216, 0, 184, 0.07);
        color: var(--kism-primary);
        transform: translateX(2px);
    }

    .kism-sidebar-link.active {
        background: rgba(216, 0, 184, 0.11);
        color: var(--kism-primary);
        font-weight: 700;
    }

    .kism-sidebar-link.active i {
        color: var(--kism-primary);
    }

    .kism-sidebar-footer {
        padding: 13px 15px;
        border-top: 1px solid var(--kism-border);
        color: var(--kism-muted);
        font-size: 0.75rem;
        text-align: center;
        white-space: nowrap;
    }

    /* ============================================================
       MAIN WRAPPER
       ============================================================ */

    .kism-main-wrapper {
        min-height: 100vh;
        margin-left: var(--kism-sidebar-width);
        display: flex;
        flex-direction: column;
        transition: margin-left 0.25s ease;
    }

    /* Only public/anonymous pages use the full width */
    .kism-public-wrapper {
        margin-left: 0;
    }

    /* ============================================================
       TOPBAR
       ============================================================ */

    .kism-topbar {
        position: sticky;
        top: 0;
        z-index: 1030;
        height: var(--kism-topbar-height);
        min-height: var(--kism-topbar-height);
        background: var(--kism-primary);
        border-bottom: 1px solid var(--kism-primary-dark);
        box-shadow: 0 3px 14px rgba(216, 0, 184, 0.18);
        display: flex;
        align-items: center;
        padding: 0 24px;
    }

    .kism-topbar-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .kism-sidebar-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        padding: 0;
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.10);
        color: #ffffff;
        font-size: 1.1rem;
        cursor: pointer;
        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease;
    }

    .kism-sidebar-toggle:hover,
    .kism-sidebar-toggle:focus {
        color: var(--kism-accent);
        border-color: var(--kism-accent);
        background: rgba(255, 255, 255, 0.15);
        outline: none;
    }

    .kism-page-title {
        margin: 0;
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .kism-topbar-spacer {
        flex: 1;
    }

    /* ============================================================
       MAIN CONTENT
       ============================================================ */

    .kism-main {
        flex: 1;
        width: 100%;
        padding: 24px;
    }

    /* ============================================================
       FOOTER
       ============================================================ */

    .kism-footer {
        background: #ffffff;
        border-top: 1px solid var(--kism-border);
        padding: 18px 24px;
        color: var(--kism-muted);
        font-size: 0.85rem;
    }

    .kism-footer-accent {
        color: var(--kism-primary);
        font-weight: 600;
    }

    /* ============================================================
       BUTTONS
       ============================================================ */

    .btn-kism-primary {
        background-color: var(--kism-primary);
        border-color: var(--kism-primary);
        color: #ffffff;
        font-weight: 600;
    }

    .btn-kism-primary:hover,
    .btn-kism-primary:focus,
    .btn-kism-primary:active {
        background-color: var(--kism-primary-dark) !important;
        border-color: var(--kism-primary-dark) !important;
        color: #ffffff !important;
    }

    /* ============================================================
       GLOBAL FORM CONTROLS
       ============================================================ */

    .form-control:focus,
    .form-select:focus {
        border-color: var(--kism-primary);
        box-shadow: 0 0 0 0.2rem rgba(216, 0, 184, 0.15);
    }

    .form-check-input:checked {
        background-color: var(--kism-primary);
        border-color: var(--kism-primary);
    }

    .text-primary {
        color: var(--kism-primary) !important;
    }

    a {
        color: var(--kism-primary);
    }

    a:hover {
        color: var(--kism-primary-dark);
    }

    /* ============================================================
       MODALS
       ============================================================ */

    .modal-content {
        border-radius: 14px;
        border: 1px solid var(--kism-border);
        box-shadow: 0 15px 45px rgba(31, 35, 45, 0.15);
    }

    .modal-header {
        border-bottom: 1px solid #eeeeee;
    }

    .modal-footer {
        border-top: 1px solid #eeeeee;
    }

    /* ============================================================
       DATATABLES
       ============================================================ */

    .dataTables_wrapper .dt-search input {
        border-radius: 8px;
        border: 1px solid #ced4da;
        padding: .45rem .75rem;
    }

    .dataTables_wrapper .dt-length select {
        border-radius: 8px;
        border: 1px solid #ced4da;
        padding: .35rem 2rem .35rem .6rem;
    }

    table.dataTable thead th {
        white-space: nowrap;
    }

    .dataTables_wrapper .dt-paging .pagination {
        margin-bottom: 0;
    }

    table.dataTable.dtr-inline.collapsed > tbody > tr > td.dtr-control:before,
    table.dataTable.dtr-inline.collapsed > tbody > tr > th.dtr-control:before {
        background-color: var(--kism-primary);
    }

    /* ============================================================
       MOBILE SIDEBAR OVERLAY
       ============================================================ */

    .kism-sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 1035;
    }

    /* ============================================================
       DESKTOP COLLAPSED SIDEBAR
       ============================================================ */

    body.kism-sidebar-collapsed .kism-sidebar {
        width: var(--kism-sidebar-collapsed-width);
    }

    body.kism-sidebar-collapsed .kism-main-wrapper {
        margin-left: var(--kism-sidebar-collapsed-width);
    }

    body.kism-sidebar-collapsed .kism-sidebar-section-title {
        justify-content: center;
        padding-left: 0;
        padding-right: 0;
    }

    body.kism-sidebar-collapsed .kism-sidebar-section-title span {
        display: none;
    }

    body.kism-sidebar-collapsed .kism-sidebar-link {
        justify-content: center;
        padding-left: 0;
        padding-right: 0;
    }

    body.kism-sidebar-collapsed .kism-sidebar-link span {
        display: none;
    }

    body.kism-sidebar-collapsed .kism-sidebar-link i {
        width: auto;
        min-width: 0;
        font-size: 1.15rem;
    }

    body.kism-sidebar-collapsed .kism-sidebar-logo {
        max-width: 48px;
        max-height: 42px;
    }

    body.kism-sidebar-collapsed .kism-sidebar-footer {
        font-size: 0;
    }

    body.kism-sidebar-collapsed .kism-sidebar-footer i {
        font-size: 1rem;
    }

    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 991.98px) {

        .kism-sidebar {
            transform: translateX(-100%);
            width: var(--kism-sidebar-width);
        }

        body.kism-sidebar-open .kism-sidebar {
            transform: translateX(0);
        }

        body.kism-sidebar-open .kism-sidebar-overlay {
            display: block;
        }

        .kism-main-wrapper {
            margin-left: 0 !important;
        }

        body.kism-sidebar-collapsed .kism-sidebar {
            width: var(--kism-sidebar-width);
        }

        body.kism-sidebar-collapsed .kism-sidebar-section-title {
            justify-content: flex-start;
            padding-left: 12px;
            padding-right: 12px;
        }

        body.kism-sidebar-collapsed .kism-sidebar-section-title span {
            display: inline;
        }

        body.kism-sidebar-collapsed .kism-sidebar-link {
            justify-content: flex-start;
            padding-left: 12px;
            padding-right: 12px;
        }

        body.kism-sidebar-collapsed .kism-sidebar-link span {
            display: inline;
        }

        body.kism-sidebar-collapsed .kism-sidebar-link i {
            width: 20px;
            min-width: 20px;
            font-size: 1.05rem;
        }

        body.kism-sidebar-collapsed .kism-sidebar-logo {
            max-width: 170px;
            max-height: 52px;
        }

        body.kism-sidebar-collapsed .kism-sidebar-footer {
            font-size: 0.75rem;
        }

        body.kism-sidebar-collapsed .kism-sidebar-footer i {
            font-size: inherit;
        }

        .kism-topbar {
            padding: 0 16px;
        }

        .kism-main {
            padding: 18px 15px;
        }

        .kism-footer {
            padding: 15px;
        }
    }

    @@media (max-width: 575.98px) {

        .kism-topbar {
            height: 64px;
            min-height: 64px;
        }

        .kism-page-title {
            font-size: 1rem;
        }

        .kism-sidebar-toggle {
            width: 38px;
            height: 38px;
        }

        .kism-main {
            padding: 15px 10px;
        }
    }
</style>

@await RenderSectionAsync("Styles", required: false)

</head>

<body>

<!-- ============================================================
     SIDEBAR
     ============================================================ -->

@if (User.Identity?.IsAuthenticated == true)
{
    @await Html.PartialAsync("_SidebarPartial")

    <div class="kism-sidebar-overlay"
         id="kismSidebarOverlay">
    </div>
}

<!-- ============================================================
     MAIN APPLICATION WRAPPER
     ============================================================ -->

<div class="kism-main-wrapper @(User.Identity?.IsAuthenticated == true ? "" : "kism-public-wrapper")">

    <!-- ========================================================
         TOPBAR
         ======================================================== -->

    <header class="kism-topbar">

        <div class="kism-topbar-left">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <button type="button"
                        class="kism-sidebar-toggle"
                        id="kismSidebarToggle"
                        aria-label="Toggle sidebar"
                        title="Toggle sidebar">

                    <i class="bi bi-list"></i>

                </button>
            }

            <h1 class="kism-page-title">
                @ViewData["Title"]
            </h1>

        </div>

        <div class="kism-topbar-spacer"></div>

        @await Html.PartialAsync("_LoginPartial")

    </header>

    <!-- ========================================================
         PAGE CONTENT
         ======================================================== -->

    <main role="main"
          class="kism-main">

        @RenderBody()

    </main>

    <!-- ========================================================
         FOOTER
         ======================================================== -->

    <footer class="kism-footer">

        <div class="text-center">

            <span>
                &copy; @DateTime.Now.Year

                <span class="kism-footer-accent">
                    Kenya Institute of Surveying and Mapping
                </span>
            </span>

        </div>

    </footer>

</div>

<!-- ============================================================
     CORE JAVASCRIPT
     ============================================================ -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<!-- DataTables -->

<script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>

<script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.min.js"></script>

<script src="https://cdn.datatables.net/responsive/3.0.6/js/dataTables.responsive.min.js"></script>

<script src="https://cdn.datatables.net/responsive/3.0.6/js/responsive.bootstrap5.min.js"></script>

<!-- SweetAlert2 -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Site JavaScript -->

<script src="~/js/site.js"
        asp-append-version="true"></script>

<!-- ============================================================
     SIDEBAR JAVASCRIPT
     ============================================================ -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const body = document.body;

        const toggleButton =
            document.getElementById("kismSidebarToggle");

        const overlay =
            document.getElementById("kismSidebarOverlay");

        if (toggleButton) {

            toggleButton.addEventListener("click", function () {

                if (window.innerWidth <= 991.98) {

                    body.classList.toggle("kism-sidebar-open");

                } else {

                    body.classList.toggle(
                        "kism-sidebar-collapsed"
                    );

                    localStorage.setItem(
                        "kismSidebarCollapsed",
                        body.classList.contains(
                            "kism-sidebar-collapsed"
                        )
                    );
                }
            });
        }

        if (overlay) {

            overlay.addEventListener("click", function () {

                body.classList.remove(
                    "kism-sidebar-open"
                );

            });
        }

        if (window.innerWidth > 991.98) {

            const savedState =
                localStorage.getItem(
                    "kismSidebarCollapsed"
                );

            if (savedState === "true") {

                body.classList.add(
                    "kism-sidebar-collapsed"
                );
            }
        }

        window.addEventListener("resize", function () {

            if (window.innerWidth > 991.98) {

                body.classList.remove(
                    "kism-sidebar-open"
                );

            } else {

                body.classList.remove(
                    "kism-sidebar-collapsed"
                );
            }

        });

    });
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>
