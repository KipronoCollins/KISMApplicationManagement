@model IEnumerable<KISMApplicationManagement.Models.Subcounty>

@using KISMApplicationManagement.Models

@{
    ViewData["Title"] = "Subcounty Management";

    var counties = Model
        .Select(s => s.County)
        .Where(c => c != null)
        .GroupBy(c => c.CountyId)
        .Select(g => g.First())
        .OrderBy(c => c.CountyNumber)
        .ThenBy(c => c.CountyName)
        .ToList();
}

@section Styles {

    <style>

        /* =========================================================
           SUBCOUNTY DATATABLE BORDERS
        ========================================================= */

        #subcountiesTable {
            border: 1px solid #dee2e6;
            border-collapse: separate;
            border-spacing: 0;
            border-radius: 8px;
            overflow: hidden;
        }

        #subcountiesTable thead th {
            border-bottom: 1px solid #dee2e6;
            border-right: 1px solid #dee2e6;
            background-color: #f8f9fa;
            font-weight: 600;
            white-space: nowrap;
        }

        #subcountiesTable thead th:last-child {
            border-right: none;
        }

        #subcountiesTable tbody td {
            border-bottom: 1px solid #dee2e6;
            border-right: 1px solid #dee2e6;
        }

        #subcountiesTable tbody td:last-child {
            border-right: none;
        }

        #subcountiesTable tbody tr:last-child td {
            border-bottom: none;
        }

        #subcountiesTable tbody tr:hover {
            background-color: rgba(216, 0, 184, 0.03);
        }


        /* =========================================================
           COUNTY FILTER
        ========================================================= */

        .subcounty-filter-label {
            font-weight: 600;
            margin-bottom: 6px;
        }

        #countyFilter {
            min-width: 240px;
            border: 1px solid #ced4da;
            border-radius: 8px;
            padding: .45rem .75rem;
        }

        #countyFilter:focus {
            border-color: #70461d;
            box-shadow: 0 0 0 .2rem rgba(216, 0, 184, .12);
        }


        /* =========================================================
           DATATABLE SEARCH / LENGTH CONTROLS
        ========================================================= */

        .dataTables_wrapper .dt-search input {
            border: 1px solid #ced4da;
            border-radius: 8px;
            padding: .45rem .75rem;
        }

        .dataTables_wrapper .dt-search input:focus {
            border-color: #70461d;
            box-shadow: 0 0 0 .2rem rgba(216, 0, 184, .12);
        }

        .dataTables_wrapper .dt-length select {
            border: 1px solid #ced4da;
            border-radius: 8px;
            padding: .35rem 2rem .35rem .6rem;
        }


        /* =========================================================
           DATATABLE PAGINATION
        ========================================================= */

        .dataTables_wrapper .dt-paging .pagination {
            margin-bottom: 0;
        }


        /* =========================================================
           MODALS
        ========================================================= */

        .modal-content {
            border-radius: 14px;
        }


        /* =========================================================
           RESPONSIVE FILTER
        ========================================================= */

        @@media (max-width: 767.98px) {

            #countyFilter {
                width: 100%;
                min-width: 0;
            }

        }

    </style>

}


<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mb-4">

        <div>

            <h1 class="h3 fw-bold mb-1">

                <i class="bi bi-diagram-3 me-2"
                   style="color:#70461d;"></i>

                Subcounty Management

            </h1>

            <p class="text-muted mb-0">
                Manage subcounties used throughout the KISM
                application system.
            </p>

        </div>

        <button type="button"
                class="btn btn-kism-primary"
                id="btnCreateSubcounty">

            <i class="bi bi-plus-circle me-1"></i>

            Add Subcounty

        </button>

    </div>


    <!-- ========================================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ========================================================= -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- SUBCOUNTY TABLE CARD -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-3 p-md-4">


            <!-- ================================================= -->
            <!-- COUNTY FILTER -->
            <!-- ================================================= -->

            <div class="row mb-4">

                <div class="col-12 col-md-4">

                    <label for="countyFilter"
                           class="form-label subcounty-filter-label">

                        <i class="bi bi-funnel me-1"
                           style="color:#70461d;"></i>

                        Filter by County

                    </label>

                    <select id="countyFilter"
                            class="form-select">

                        <option value="">
                            All Counties
                        </option>

                        @foreach (var county in counties)
                        {
                            <option value="@county.CountyName">
                                @county.CountyNumber -
                                @county.CountyName
                            </option>
                        }

                    </select>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SUBCOUNTY TABLE -->
            <!-- ================================================= -->

            <div class="table-responsive">

                <table id="subcountiesTable"
                       class="table table-hover align-middle w-100">

                    <thead>

                        <tr>

                            <th>
                                No.
                            </th>

                            <th>
                                Subcounty Name
                            </th>

                            <th>
                                County
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Created
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var subcounty in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @subcounty.County.CountyNumber
                                </td>

                                <td>
                                    @subcounty.SubcountyName
                                </td>

                                <td>
                                    @subcounty.County.CountyName
                                </td>

                                <td>

                                    @if (subcounty.IsActive)
                                    {
                                        <span class="badge bg-success-subtle
                                                     text-success border
                                                     border-success-subtle">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle
                                                     text-secondary border
                                                     border-secondary-subtle">

                                            <i class="bi bi-pause-circle me-1"></i>

                                            Inactive

                                        </span>
                                    }

                                </td>

                                <td>
                                    @subcounty.CreatedAtUtc
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                </td>

                                <td class="text-end">

                                    <div class="btn-group"
                                         role="group"
                                         aria-label="Subcounty actions">

                                        <!-- EDIT -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary btn-edit-subcounty"
                                                data-id="@subcounty.SubcountyId"
                                                title="Edit subcounty">

                                            <i class="bi bi-pencil-square"></i>

                                            <span class="visually-hidden">
                                                Edit @subcounty.SubcountyName
                                            </span>

                                        </button>


                                        <!-- TOGGLE STATUS -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary btn-toggle-subcounty"
                                                data-id="@subcounty.SubcountyId"
                                                data-name="@subcounty.SubcountyName"
                                                data-active="@subcounty.IsActive.ToString().ToLowerInvariant()"
                                                title="Change subcounty status">

                                            @if (subcounty.IsActive)
                                            {
                                                <i class="bi bi-toggle-on"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-toggle-off"></i>
                                            }

                                            <span class="visually-hidden">
                                                Change status for @subcounty.SubcountyName
                                            </span>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- CREATE SUBCOUNTY MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="createSubcountyModal"
     tabindex="-1"
     aria-labelledby="createSubcountyModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold"
                    id="createSubcountyModalLabel">

                    <i class="bi bi-plus-circle me-2"
                       style="color:#70461d;"></i>

                    Add Subcounty

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body"
                 id="createSubcountyModalBody">

                <div class="text-center py-4">

                    <div class="spinner-border"
                         style="color:#70461d;"
                         role="status">

                        <span class="visually-hidden">
                            Loading...
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- EDIT SUBCOUNTY MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="editSubcountyModal"
     tabindex="-1"
     aria-labelledby="editSubcountyModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold"
                    id="editSubcountyModalLabel">

                    <i class="bi bi-pencil-square me-2"
                       style="color:#70461d;"></i>

                    Edit Subcounty

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body"
                 id="editSubcountyModalBody">

                <div class="text-center py-4">

                    <div class="spinner-border"
                         style="color:#70461d;"
                         role="status">

                        <span class="visually-hidden">
                            Loading...
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        $(document).ready(function () {


            /* =====================================================
               DATATABLE
            ===================================================== */

            const subcountiesTable =
                $('#subcountiesTable').DataTable({

                    responsive: true,

                    pageLength: 10,

                    lengthMenu: [
                        [10, 25, 50, 100, -1],
                        [10, 25, 50, 100, 'All']
                    ],

                    order: [
                        [0, 'asc'],
                        [1, 'asc']
                    ],

                    columnDefs: [

                        {
                            targets: 5,
                            orderable: false,
                            searchable: false
                        }

                    ],

                    language: {

                        search: "",

                        searchPlaceholder:
                            "Search subcounties..."

                    }

                });


            /* =====================================================
               COUNTY FILTER
            ===================================================== */

            $('#countyFilter').on(
                'change',
                function () {

                    const selectedCounty =
                        $(this).val();

                    /*
                     * County is column 2.
                     *
                     * Empty value means show
                     * all counties.
                     */

                    subcountiesTable
                        .column(2)
                        .search(selectedCounty)
                        .draw();

                });


            /* =====================================================
               CREATE SUBCOUNTY
            ===================================================== */

            $('#btnCreateSubcounty').on(
                'click',
                function () {

                    const modalElement =
                        document.getElementById(
                            'createSubcountyModal'
                        );

                    const modal =
                        bootstrap.Modal.getOrCreateInstance(
                            modalElement
                        );


                    $('#createSubcountyModalBody').html(`

                        <div class="text-center py-4">

                            <div class="spinner-border"
                                 style="color:#70461d;"
                                 role="status">

                                <span class="visually-hidden">
                                    Loading...
                                </span>

                            </div>

                        </div>

                    `);


                    modal.show();


                    $.get(
                        '@Url.Action("Create", "Subcounty")'
                    )

                    .done(function (html) {

                        $('#createSubcountyModalBody')
                            .html(html);

                    })

                    .fail(function () {

                        $('#createSubcountyModalBody').html(`

                            <div class="alert alert-danger mb-0">

                                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                                Unable to load the subcounty form.
                                Please try again.

                            </div>

                        `);

                    });

                });


            /* =====================================================
               EDIT SUBCOUNTY
            ===================================================== */

            $(document).on(
                'click',
                '.btn-edit-subcounty',
                function () {

                    const id =
                        $(this).data('id');


                    const modalElement =
                        document.getElementById(
                            'editSubcountyModal'
                        );


                    const modal =
                        bootstrap.Modal.getOrCreateInstance(
                            modalElement
                        );


                    $('#editSubcountyModalBody').html(`

                        <div class="text-center py-4">

                            <div class="spinner-border"
                                 style="color:#70461d;"
                                 role="status">

                                <span class="visually-hidden">
                                    Loading...
                                </span>

                            </div>

                        </div>

                    `);


                    modal.show();


                    const editUrl =
                        '@Url.Action("Edit", "Subcounty")' +
                        '/' +
                        encodeURIComponent(id);


                    $.get(editUrl)

                    .done(function (html) {

                        $('#editSubcountyModalBody')
                            .html(html);

                    })

                    .fail(function () {

                        $('#editSubcountyModalBody').html(`

                            <div class="alert alert-danger mb-0">

                                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                                Unable to load the subcounty form.
                                Please try again.

                            </div>

                        `);

                    });

                });


            /* =====================================================
               CREATE / EDIT FORM SUBMISSION
            ===================================================== */

            $(document).on(
                'submit',
                '#createSubcountyForm, #editSubcountyForm',
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();


                    const form = this;


                    if (!form.checkValidity()) {

                        form.classList.add(
                            'was-validated'
                        );

                        return;

                    }


                    const submitButton =
                        $(form).find(
                            'button[type="submit"]'
                        );


                    const originalButtonHtml =
                        submitButton.html();


                    submitButton.prop(
                        'disabled',
                        true
                    );


                    submitButton.html(`

                        <span class="spinner-border spinner-border-sm me-1"
                              role="status"
                              aria-hidden="true"></span>

                        Saving...

                    `);


                    $.ajax({

                        url: form.action,

                        type: 'POST',

                        data: $(form).serialize(),

                        success: function (
                            response,
                            status,
                            xhr
                        ) {

                            /*
                             * Successful save returns
                             * the Subcounty Index page.
                             */

                            if (
                                response &&
                                response.indexOf(
                                    'subcountiesTable'
                                ) !== -1
                            ) {

                                const modalElement =
                                    form.closest(
                                        '.modal'
                                    );


                                const modal =
                                    bootstrap.Modal
                                        .getInstance(
                                            modalElement
                                        );


                                if (modal) {

                                    modal.hide();

                                }


                                $('body')
                                    .removeClass(
                                        'modal-open'
                                    );


                                $('.modal-backdrop')
                                    .remove();


                                window.location.replace(
                                    '@Url.Action("Index", "Subcounty")'
                                );


                                return;

                            }


                            /* -------------------------------------------------
                               SERVER-SIDE VALIDATION
                            ------------------------------------------------- */

                            if (
                                form.id ===
                                'createSubcountyForm'
                            ) {

                                $('#createSubcountyModalBody')
                                    .html(response);

                            }
                            else {

                                $('#editSubcountyModalBody')
                                    .html(response);

                            }

                        },


                        error: function (xhr) {

                            if (
                                xhr.responseText &&
                                xhr.responseText
                                    .indexOf(
                                        'editSubcountyForm'
                                    ) !== -1
                            ) {

                                $('#editSubcountyModalBody')
                                    .html(
                                        xhr.responseText
                                    );

                                return;

                            }


                            if (
                                xhr.responseText &&
                                xhr.responseText
                                    .indexOf(
                                        'createSubcountyForm'
                                    ) !== -1
                            ) {

                                $('#createSubcountyModalBody')
                                    .html(
                                        xhr.responseText
                                    );

                                return;

                            }


                            Swal.fire({

                                icon: 'error',

                                title:
                                    'Unable to save subcounty',

                                text:
                                    'The subcounty could not be saved. Please try again.',

                                confirmButtonColor:
                                    '#70461d'

                            });


                            submitButton.prop(
                                'disabled',
                                false
                            );


                            submitButton.html(
                                originalButtonHtml
                            );

                        }

                    });

                });


            /* =====================================================
               ACTIVATE / DEACTIVATE SUBCOUNTY
            ===================================================== */

            $(document).on(
                'click',
                '.btn-toggle-subcounty',
                function () {

                    const button =
                        $(this);


                    const id =
                        button.data('id');


                    const name =
                        button.data('name');


                    const isActive =
                        button.data('active') === true ||
                        button.data('active') === 'true' ||
                        button.data('active') === 'True';


                    const escapedName =
                        $('<div>')
                            .text(name)
                            .html();


                    const title =
                        isActive
                            ? 'Deactivate Subcounty?'
                            : 'Activate Subcounty?';


                    const message =
                        isActive

                            ? `Are you sure you want to deactivate <strong>${escapedName}</strong>?`

                            : `Are you sure you want to activate <strong>${escapedName}</strong>?`;


                    Swal.fire({

                        title: title,

                        html: message,

                        icon:
                            isActive
                                ? 'warning'
                                : 'question',

                        showCancelButton: true,

                        confirmButtonText:
                            isActive
                                ? 'Yes, deactivate'
                                : 'Yes, activate',

                        cancelButtonText:
                            'Cancel',

                        confirmButtonColor:
                            '#70461d',

                        cancelButtonColor:
                            '#6c757d'

                    }).then(function (result) {

                        if (!result.isConfirmed) {

                            return;

                        }


                        const form =
                            $('<form>', {

                                method: 'POST',

                                action:
                                    '@Url.Action("ToggleStatus", "Subcounty")'

                            });


                        form.append(
                            $('<input>', {

                                type: 'hidden',

                                name: 'id',

                                value: id

                            })
                        );


                        const token =
                            $('input[name="__RequestVerificationToken"]')
                                .first()
                                .clone();


                        if (token.length) {

                            form.append(token);

                        }


                        $('body').append(form);

                        form.submit();

                    });

                });

        });

    </script>

}