@model KISMApplicationManagement.Models.County

<form asp-action="Create"
      asp-controller="County"
      method="post"
      id="createCountyForm">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <!-- County Number -->

    <div class="mb-3">

        <label asp-for="CountyNumber"
               class="form-label fw-semibold">

            County Number

        </label>

        <input asp-for="CountyNumber"
               type="number"
               class="form-control"
               min="1"
               max="47"
               placeholder="Enter county number"
               required
               autofocus />

        <div class="form-text">

            Enter a unique county number from 1 to 47.

        </div>

        <span asp-validation-for="CountyNumber"
              class="text-danger small">
        </span>

    </div>


    <!-- County Name -->

    <div class="mb-3">

        <label asp-for="CountyName"
               class="form-label fw-semibold">

            County Name

        </label>

        <input asp-for="CountyName"
               class="form-control"
               placeholder="Enter county name"
               autocomplete="off"
               maxlength="100"
               required />

        <span asp-validation-for="CountyName"
              class="text-danger small">
        </span>

    </div>


    <!-- Status -->

    <div class="form-check form-switch mb-3">

        <input asp-for="IsActive"
               class="form-check-input"
               role="switch"
               id="createCountyIsActive" />

        <label class="form-check-label fw-semibold"
               for="createCountyIsActive">

            Active

        </label>

        <div class="form-text">

            Active counties will be available for selection
            in the application system.

        </div>

    </div>


    <!-- Buttons -->

    <div class="d-flex justify-content-end gap-2 pt-2">

        <button type="button"
                class="btn btn-light border"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                class="btn btn-kism-primary"
                id="createCountySubmit">

            <i class="bi bi-check-circle me-1"></i>

            Save County

        </button>

    </div>

</form>