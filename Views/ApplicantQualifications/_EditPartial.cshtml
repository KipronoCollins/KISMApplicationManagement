@model KISMApplicationManagement.ViewModels.ApplicantQualifications.ApplicantQualificationViewModel

<form asp-action="Edit"
      asp-controller="ApplicantQualifications"
      method="post"
      id="editQualificationForm"
      novalidate>

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="ApplicantQualificationId" />

    <div class="mb-4">

        <h6 class="fw-bold mb-1">
            Edit Academic Qualification
        </h6>

        <p class="text-muted small mb-0">
            Update the qualification information below. Changes may be subject
            to verification by KISM admissions staff.
        </p>

    </div>


    <!-- Qualification Route -->
    <div class="section-box">

        <div class="section-box-title">

            <i class="bi bi-signpost-2 text-kism"></i>

            Qualification Route

        </div>


        <div class="route-selection">

            <div class="route-option">

                <input type="radio"
                       asp-for="QualificationRoute"
                       value="KCSE"
                       id="editQualificationRouteKcse"
                       required />

                <label for="editQualificationRouteKcse">

                    <div class="d-flex align-items-center gap-2 mb-1">

                        <i class="bi bi-journal-text text-kism"></i>

                        <span class="route-option-title">
                            KCSE
                        </span>

                    </div>

                    <div class="route-option-description">

                        Kenya Certificate of Secondary Education
                        with subject grades.

                    </div>

                </label>

            </div>


            <div class="route-option">

                <input type="radio"
                       asp-for="QualificationRoute"
                       value="KNEC"
                       id="editQualificationRouteKnec"
                       required />

                <label for="editQualificationRouteKnec">

                    <div class="d-flex align-items-center gap-2 mb-1">

                        <i class="bi bi-award-fill text-kism"></i>

                        <span class="route-option-title">
                            KNEC
                        </span>

                    </div>

                    <div class="route-option-description">

                        KNEC technical qualification such as
                        Craft Certificate or Artisan qualification.

                    </div>

                </label>

            </div>

        </div>


        <span asp-validation-for="QualificationRoute"
              class="text-danger small">
        </span>

    </div>


    <!-- Common Information -->
    <div class="section-box">

        <div class="section-box-title">

            <i class="bi bi-calendar3 text-kism"></i>

            Qualification Information

        </div>


        <div class="row g-3">

            <div class="col-md-4">

                <label asp-for="QualificationYear"
                       class="form-label">
                    Qualification Year
                </label>

                <input asp-for="QualificationYear"
                       class="form-control"
                       type="number"
                       min="1900"
                       max="2100"
                       placeholder="e.g. 2024"
                       required />

                <div class="form-text">
                    Enter the year you obtained the qualification.
                </div>

                <span asp-validation-for="QualificationYear"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>


    <!-- KCSE Section -->
    <div class="section-box kcse-section d-none">

        <div class="section-box-title">

            <i class="bi bi-journal-text text-kism"></i>

            KCSE Details

        </div>


        <div class="row g-3">

            <div class="col-md-6">

                <label asp-for="ExaminationIndexNumber"
                       class="form-label">
                    Examination Index Number
                </label>

                <input asp-for="ExaminationIndexNumber"
                       class="form-control"
                       maxlength="100"
                       placeholder="Enter KCSE index number" />

                <span asp-validation-for="ExaminationIndexNumber"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="MeanGrade"
                       class="form-label">
                    Mean Grade
                </label>

                <select asp-for="MeanGrade"
                        class="form-select">

                    <option value="">
                        Select mean grade
                    </option>

                    <option value="A">A</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B">B</option>
                    <option value="B-">B-</option>
                    <option value="C+">C+</option>
                    <option value="C">C</option>
                    <option value="C-">C-</option>
                    <option value="D+">D+</option>
                    <option value="D">D</option>
                    <option value="D-">D-</option>
                    <option value="E">E</option>

                </select>

                <span asp-validation-for="MeanGrade"
                      class="text-danger small">
                </span>

            </div>

        </div>


        <!-- KCSE Subjects -->
        <div class="mt-4">

            <div class="d-flex align-items-center justify-content-between gap-2 mb-3">

                <div>

                    <div class="fw-bold">
                        KCSE Subjects
                    </div>

                    <div class="small text-muted">
                        Update the subjects and grades appearing on your KCSE certificate.
                    </div>

                </div>


                <button type="button"
                        class="btn btn-add-subject btn-sm">

                    <i class="bi bi-plus-circle me-1"></i>

                    Add Subject

                </button>

            </div>


            <div id="subjectsContainer">

                @if (Model.Subjects != null && Model.Subjects.Any())
                {
                    for (var i = 0; i < Model.Subjects.Count; i++)
                    {
                        <div class="subject-row">

                            <input type="hidden"
                                   name="Subjects[@i].ApplicantQualificationSubjectId"
                                   value="@Model.Subjects[i].ApplicantQualificationSubjectId" />

                            <input type="hidden"
                                   name="Subjects[@i].ApplicantQualificationId"
                                   value="@Model.Subjects[i].ApplicantQualificationId" />


                            <div class="row g-2 align-items-end">

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Subject Name
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           name="Subjects[@i].SubjectName"
                                           value="@Model.Subjects[i].SubjectName"
                                           maxlength="150"
                                           placeholder="e.g. Mathematics"
                                           required />

                                    <div class="invalid-feedback">
                                        Please enter the subject name.
                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <label class="form-label">
                                        Grade
                                    </label>

                                    <select class="form-select"
                                            name="Subjects[@i].Grade"
                                            required>

                                        <option value="">
                                            Select grade
                                        </option>

                                        @foreach (var grade in new[]
                                        {
                                            "A",
                                            "A-",
                                            "B+",
                                            "B",
                                            "B-",
                                            "C+",
                                            "C",
                                            "C-",
                                            "D+",
                                            "D",
                                            "D-",
                                            "E"
                                        })
                                        {
                                            if (Model.Subjects[i].Grade == grade)
                                            {
                                                <option value="@grade" selected>
                                                    @grade
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@grade">
                                                    @grade
                                                </option>
                                            }
                                        }

                                    </select>

                                    <div class="invalid-feedback">
                                        Please select the subject grade.
                                    </div>

                                </div>


                                <div class="col-md-2">

                                    <button type="button"
                                            class="btn btn-outline-danger w-100 btn-remove-subject">

                                        <i class="bi bi-trash3"></i>

                                        Remove

                                    </button>

                                </div>

                            </div>

                        </div>
                    }
                }

            </div>


            <div class="small text-muted mt-2">

                <i class="bi bi-info-circle me-1"></i>

                Make sure the subjects and grades match your qualification documents.

            </div>


            <span asp-validation-for="Subjects"
                  class="text-danger small">
            </span>

        </div>

    </div>


    <!-- KNEC Section -->
    <div class="section-box knec-section d-none">

        <div class="section-box-title">

            <i class="bi bi-award-fill text-kism"></i>

            KNEC Qualification Details

        </div>


        <div class="row g-3">

            <div class="col-md-6">

                <label asp-for="QualificationType"
                       class="form-label">
                    Qualification Type
                </label>

                <select asp-for="QualificationType"
                        class="form-select">

                    <option value="">
                        Select qualification type
                    </option>

                    <option value="Craft Certificate">
                        Craft Certificate
                    </option>

                    <option value="Artisan">
                        Artisan
                    </option>

                    <option value="Diploma">
                        Diploma
                    </option>

                    <option value="Other">
                        Other
                    </option>

                </select>

                <span asp-validation-for="QualificationType"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="CertificateNumber"
                       class="form-label">
                    Certificate Number
                </label>

                <input asp-for="CertificateNumber"
                       class="form-control"
                       maxlength="150"
                       placeholder="Enter certificate number" />

                <span asp-validation-for="CertificateNumber"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="InstitutionName"
                       class="form-label">
                    Institution
                </label>

                <input asp-for="InstitutionName"
                       class="form-control"
                       maxlength="200"
                       placeholder="Name of institution" />

                <span asp-validation-for="InstitutionName"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="FieldOfStudy"
                       class="form-label">
                    Field of Study
                </label>

                <input asp-for="FieldOfStudy"
                       class="form-control"
                       maxlength="200"
                       placeholder="e.g. Land Survey" />

                <span asp-validation-for="FieldOfStudy"
                      class="text-danger small">
                </span>

            </div>


            <div class="col-12">

                <label asp-for="Description"
                       class="form-label">
                    Additional Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          maxlength="2000"
                          placeholder="Add any additional information about this qualification, if applicable."></textarea>

                <span asp-validation-for="Description"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>


    <!-- Verification Information -->
    <div class="alert alert-warning border-0 rounded-3 mb-0">

        <div class="d-flex gap-2">

            <i class="bi bi-exclamation-circle fs-5"></i>

            <div>

                <div class="fw-semibold">
                    Important
                </div>

                <div class="small">

                    Changes to your qualification information may require
                    the qualification to be reviewed again by KISM admissions staff.

                </div>

            </div>

        </div>

    </div>


    <div class="modal-footer px-0 pb-0 mt-4">

        <button type="button"
                class="btn btn-light border"
                data-bs-dismiss="modal">

            Cancel

        </button>


        <button type="submit"
                class="btn btn-kism">

            <i class="bi bi-check-circle me-1"></i>

            Save Changes

        </button>

    </div>

</form>


<style>

    .text-kism {
        color: #70461d !important;
    }

</style>