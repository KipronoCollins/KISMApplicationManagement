@model KISMApplicationManagement.Models.Division

@using KISMApplicationManagement.Models

@{
    var counties =
        ViewBag.Counties as IEnumerable<County>
        ?? Enumerable.Empty<County>();

    var subcounties =
        ViewBag.Subcounties as IEnumerable<Subcounty>
        ?? Enumerable.Empty<Subcounty>();

    var selectedSubcounty =
        subcounties.FirstOrDefault(
            s => s.SubcountyId == Model.SubcountyId);

    var selectedCountyId =
        selectedSubcounty?.CountyId;
}

<form asp-action="Edit"
      asp-controller="Division"
      asp-route-id="@Model.DivisionId"
      method="post"
      id="editDivisionForm">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="DivisionId" />


    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <!-- ========================================================= -->
    <!-- COUNTY -->
    <!-- ========================================================= -->

    <div class="mb-3">

        <label for="editDivisionCountyId"
               class="form-label fw-semibold">

            County

        </label>

        <select id="editDivisionCountyId"
                class="form-select"
                required>

            <option value="">
                Select county
            </option>

            @foreach (var county in counties)
            {
                <option value="@county.CountyId"
                        selected="@(selectedCountyId == county.CountyId)">

                    @county.CountyNumber -
                    @county.CountyName

                </option>
            }

        </select>

        <div class="form-text">

            Select the county first.

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SUBCOUNTY -->
    <!-- ========================================================= -->

    <div class="mb-3">

        <label asp-for="SubcountyId"
               class="form-label fw-semibold">

            Subcounty

        </label>

        <select asp-for="SubcountyId"
                id="editDivisionSubcountyId"
                class="form-select"
                required>

            <option value="">
                Select subcounty
            </option>

            @foreach (var subcounty in subcounties)
            {
                <option value="@subcounty.SubcountyId"
                        data-county-id="@subcounty.CountyId">

                    @subcounty.SubcountyName

                </option>
            }

        </select>

        <div class="form-text">

            Select the subcounty where this division belongs.

        </div>

        <span asp-validation-for="SubcountyId"
              class="text-danger small">
        </span>

    </div>


    <!-- ========================================================= -->
    <!-- DIVISION NAME -->
    <!-- ========================================================= -->

    <div class="mb-3">

        <label asp-for="DivisionName"
               class="form-label fw-semibold">

            Division Name

        </label>

        <input asp-for="DivisionName"
               class="form-control"
               placeholder="Enter division name"
               autocomplete="off"
               maxlength="100"
               required />

        <span asp-validation-for="DivisionName"
              class="text-danger small">
        </span>

    </div>


    <!-- ========================================================= -->
    <!-- STATUS -->
    <!-- ========================================================= -->

    <div class="form-check form-switch mb-3">

        <input asp-for="IsActive"
               class="form-check-input"
               role="switch"
               id="editDivisionIsActive" />

        <label class="form-check-label fw-semibold"
               for="editDivisionIsActive">

            Active

        </label>

        <div class="form-text">

            Active divisions will be available for
            selection in the application system.

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ACTIONS -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-end gap-2 pt-2">

        <button type="button"
                class="btn btn-light border"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                class="btn btn-kism-primary"
                id="editDivisionSubmit">

            <i class="bi bi-check-circle me-1"></i>

            Save Changes

        </button>

    </div>

</form>


<script>

    (function () {

        const countySelect =
            document.getElementById(
                "editDivisionCountyId"
            );

        const subcountySelect =
            document.getElementById(
                "editDivisionSubcountyId"
            );

        const form =
            document.getElementById(
                "editDivisionForm"
            );


        if (
            !countySelect ||
            !subcountySelect ||
            !form
        ) {

            return;

        }


        const originalSubcountyId =
            "@Model.SubcountyId";


        /* =====================================================
           FILTER SUBCOUNTIES
        ===================================================== */

        function filterSubcounties(
            countyId,
            preserveSelection
        ) {

            Array.from(
                subcountySelect.options
            ).forEach(function (option) {

                if (!option.value) {

                    option.hidden = false;

                    return;

                }


                option.hidden =
                    option.dataset.countyId !== countyId;

            });


            subcountySelect.disabled =
                !countyId;


            if (preserveSelection) {

                subcountySelect.value =
                    originalSubcountyId;

            }
            else {

                subcountySelect.value = "";

            }

        }


        /* =====================================================
           INITIAL STATE
        ===================================================== */

        filterSubcounties(
            countySelect.value,
            true
        );


        /* =====================================================
           COUNTY CHANGE
        ===================================================== */

        countySelect.addEventListener(
            "change",
            function () {

                filterSubcounties(
                    this.value,
                    false
                );

            });


        /* =====================================================
           VALIDATION
        ===================================================== */

        form.addEventListener(
            "submit",
            function (event) {

                if (!form.checkValidity()) {

                    event.preventDefault();

                    event.stopPropagation();

                    form.classList.add(
                        "was-validated"
                    );

                }

            }
        );

    })();

</script>