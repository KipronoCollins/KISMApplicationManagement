@model KISMApplicationManagement.Models.Division

@using KISMApplicationManagement.Models

@{
    var counties =
        ViewBag.Counties as IEnumerable<County>
        ?? Enumerable.Empty<County>();

    var subcounties =
        ViewBag.Subcounties as IEnumerable<Subcounty>
        ?? Enumerable.Empty<Subcounty>();
}

<form asp-action="Create"
      asp-controller="Division"
      method="post"
      id="createDivisionForm">

    @Html.AntiForgeryToken()


    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <!-- ========================================================= -->
    <!-- COUNTY -->
    <!-- ========================================================= -->

    <div class="mb-3">

        <label for="createDivisionCountyId"
               class="form-label fw-semibold">

            County

        </label>

        <select id="createDivisionCountyId"
                class="form-select"
                required>

            <option value="">
                Select county
            </option>

            @foreach (var county in counties)
            {
                <option value="@county.CountyId">

                    @county.CountyNumber -
                    @county.CountyName

                </option>
            }

        </select>

        <div class="form-text">

            Select the county first.

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SUBCOUNTY -->
    <!-- ========================================================= -->

    <div class="mb-3">

        <label asp-for="SubcountyId"
               class="form-label fw-semibold">

            Subcounty

        </label>

        <select asp-for="SubcountyId"
                id="createDivisionSubcountyId"
                class="form-select"
                required
                disabled>

            <option value="">
                Select subcounty
            </option>

            @foreach (var subcounty in subcounties)
            {
                <option value="@subcounty.SubcountyId"
                        data-county-id="@subcounty.CountyId">

                    @subcounty.SubcountyName

                </option>
            }

        </select>

        <div class="form-text">

            Select the subcounty where this division belongs.

        </div>

        <span asp-validation-for="SubcountyId"
              class="text-danger small">
        </span>

    </div>


    <!-- ========================================================= -->
    <!-- DIVISION NAME -->
    <!-- ========================================================= -->

    <div class="mb-3">

        <label asp-for="DivisionName"
               class="form-label fw-semibold">

            Division Name

        </label>

        <input asp-for="DivisionName"
               class="form-control"
               placeholder="Enter division name"
               autocomplete="off"
               maxlength="100"
               required />

        <span asp-validation-for="DivisionName"
              class="text-danger small">
        </span>

    </div>


    <!-- ========================================================= -->
    <!-- STATUS -->
    <!-- ========================================================= -->

    <div class="form-check form-switch mb-3">

        <input asp-for="IsActive"
               class="form-check-input"
               role="switch"
               id="createDivisionIsActive" />

        <label class="form-check-label fw-semibold"
               for="createDivisionIsActive">

            Active

        </label>

        <div class="form-text">

            Active divisions will be available for
            selection in the application system.

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ACTIONS -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-end gap-2 pt-2">

        <button type="button"
                class="btn btn-light border"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                class="btn btn-kism-primary"
                id="createDivisionSubmit">

            <i class="bi bi-check-circle me-1"></i>

            Save Division

        </button>

    </div>

</form>


<script>

    (function () {

        const countySelect =
            document.getElementById(
                "createDivisionCountyId"
            );

        const subcountySelect =
            document.getElementById(
                "createDivisionSubcountyId"
            );

        const form =
            document.getElementById(
                "createDivisionForm"
            );


        if (
            !countySelect ||
            !subcountySelect ||
            !form
        ) {

            return;

        }


        /* =====================================================
           COUNTY → SUBCOUNTY
        ===================================================== */

        countySelect.addEventListener(
            "change",
            function () {

                const countyId =
                    this.value;


                subcountySelect.value = "";


                Array.from(
                    subcountySelect.options
                ).forEach(function (option) {

                    if (!option.value) {

                        option.hidden = false;

                        return;

                    }


                    option.hidden =
                        option.dataset.countyId !== countyId;

                });


                subcountySelect.disabled =
                    !countyId;

            });


        /* =====================================================
           VALIDATION
        ===================================================== */

        form.addEventListener(
            "submit",
            function (event) {

                if (!form.checkValidity()) {

                    event.preventDefault();

                    event.stopPropagation();

                    form.classList.add(
                        "was-validated"
                    );

                }

            }
        );

    })();

</script>