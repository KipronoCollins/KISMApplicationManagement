@model KISMApplicationManagement.Models.ProgrammeRequirementGroup

<div class="modal-header border-0 pb-0">

    <div>

        <h5 class="modal-title fw-bold">

            <i class="bi bi-diagram-3 me-2"
               style="color:#70461d;"></i>

            @Model.GroupName

        </h5>

        <small class="text-muted">
            @Model.Programme.ProgrammeName
        </small>

    </div>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal">
    </button>

</div>

<div class="modal-body">

    <!-- Group Information -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="border rounded-3 p-3 h-100">

                <small class="text-muted d-block">
                    Selection Rule
                </small>

                <strong>
                    @Model.SelectionRule

                    @if (Model.SelectionRule == "ANY")
                    {
                        <span>
                            · @Model.MinimumRequired required
                        </span>
                    }

                </strong>

            </div>

        </div>

        <div class="col-md-4">

            <div class="border rounded-3 p-3 h-100">

                <small class="text-muted d-block">
                    Parent Group
                </small>

                <strong>
                    @(Model.ParentGroup?.GroupName ?? "Top Level")
                </strong>

            </div>

        </div>

        <div class="col-md-4">

            <div class="border rounded-3 p-3 h-100">

                <small class="text-muted d-block">
                    Status
                </small>

                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactive
                    </span>
                }

            </div>

        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="alert alert-light border">

            <strong>Description</strong>

            <div class="mt-1">
                @Model.Description
            </div>

        </div>
    }

    <!-- Child Groups -->
    <div class="d-flex
                justify-content-between
                align-items-center
                mb-3">

        <h6 class="fw-bold mb-0">
            Child Groups
        </h6>

        <button type="button"
                class="btn btn-sm text-white btn-add-child-group"
                data-programme-id="@Model.ProgrammeId"
                data-parent-group-id="@Model.ProgrammeRequirementGroupId"
                style="background:#70461d;">

            <i class="bi bi-plus-lg me-1"></i>

            Add Child Group

        </button>

    </div>

    @if (Model.ChildGroups.Any())
    {
        <div class="row g-2 mb-4">

            @foreach (var child in Model.ChildGroups
                .OrderBy(g => g.DisplayOrder)
                .ThenBy(g => g.GroupName))
            {
                <div class="col-md-6">

                    <div class="border rounded-3 p-3">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-start
                                    gap-2">

                            <div>

                                <div class="fw-semibold">
                                    @child.GroupName
                                </div>

                                <small class="text-muted">

                                    @child.SelectionRule

                                    @if (child.SelectionRule == "ANY")
                                    {
                                        <span>
                                            · @child.MinimumRequired required
                                        </span>
                                    }

                                </small>

                            </div>

                            @if (child.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="small text-muted mb-4">
            No child groups have been added.
        </div>
    }

    <!-- Requirements -->
    <div class="d-flex
                justify-content-between
                align-items-center
                mb-3">

        <h6 class="fw-bold mb-0">
            Requirements
        </h6>

        <button type="button"
                class="btn btn-sm text-white btn-add-requirement"
                data-group-id="@Model.ProgrammeRequirementGroupId"
                style="background:#70461d;">

            <i class="bi bi-plus-lg me-1"></i>

            Add Requirement

        </button>

    </div>

    @if (Model.Requirements.Any())
    {
        <div class="table-responsive">

            <table class="table table-sm align-middle">

                <thead>

                    <tr>

                        <th>Order</th>

                        <th>Requirement</th>

                        <th>Type</th>

                        <th>Subject</th>

                        <th>Value</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var requirement in Model.Requirements
                        .OrderBy(r => r.DisplayOrder)
                        .ThenBy(r => r.RequirementName))
                    {
                        <tr>

                            <td>
                                @requirement.DisplayOrder
                            </td>

                            <td class="fw-semibold">
                                @requirement.RequirementName
                            </td>

                            <td>
                                @requirement.RequirementType
                            </td>

                            <td>
                                @(requirement.SubjectName ?? "—")
                            </td>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                    requirement.ComparisonOperator))
                                {
                                    @requirement.ComparisonOperator
                                }

                                @if (!string.IsNullOrWhiteSpace(
                                    requirement.RequiredValue))
                                {
                                    @requirement.RequiredValue
                                }

                                @if (string.IsNullOrWhiteSpace(
                                    requirement.ComparisonOperator) &&
                                    string.IsNullOrWhiteSpace(
                                    requirement.RequiredValue))
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>

                            <td>

                                @if (requirement.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">

            <i class="bi bi-list-check fs-1 d-block mb-2"></i>

            <div class="fw-semibold">
                No requirements have been added yet.
            </div>

            <small>
                Add requirements to configure this group.
            </small>

        </div>
    }

</div>

<div class="modal-footer border-0">

    <button type="button"
            class="btn btn-light"
            data-bs-dismiss="modal">

        Close

    </button>

</div>