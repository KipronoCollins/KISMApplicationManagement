@model KISMApplicationManagement.Models.ProgrammeRequirementGroup

<form id="createRequirementGroupForm"
      asp-action="CreateGroup"
      asp-controller="ProgrammeRequirements"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="ProgrammeId" />

    <input type="hidden"
           asp-for="ParentGroupId" />

    <div class="modal-header border-0 pb-0">

        <div>

            <h5 class="modal-title fw-bold">

                <i class="bi bi-diagram-3 me-2"
                   style="color:#70461d;"></i>

                Create Requirement Group

            </h5>

            <small class="text-muted">

                @ViewBag.ProgrammeName

                @if (!string.IsNullOrWhiteSpace(
                    ViewBag.ParentGroupName as string))
                {
                    <span>
                        · Child of
                        <strong>
                            @ViewBag.ParentGroupName
                        </strong>
                    </span>
                }

            </small>

        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>

    </div>

    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="mb-3">

            <label asp-for="GroupName"
                   class="form-label fw-semibold">
            </label>

            <input asp-for="GroupName"
                   class="form-control"
                   placeholder="e.g. Academic Qualification" />

            <span asp-validation-for="GroupName"
                  class="text-danger small">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Description"
                   class="form-label fw-semibold">
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="3"
                      placeholder="Describe what this group represents."></textarea>

            <span asp-validation-for="Description"
                  class="text-danger small">
            </span>

        </div>

        <div class="row g-3">

            <div class="col-md-6">

                <label asp-for="SelectionRule"
                       class="form-label fw-semibold">
                </label>

                <select asp-for="SelectionRule"
                        class="form-select"
                        id="createGroupSelectionRule">

                    <option value="ALL">
                        ALL — every child must be satisfied
                    </option>

                    <option value="ANY">
                        ANY — alternatives are allowed
                    </option>

                </select>

                <div class="form-text">
                    Use ANY for alternative qualification routes.
                </div>

            </div>

            <div class="col-md-6">

                <label asp-for="MinimumRequired"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="MinimumRequired"
                       class="form-control"
                       type="number"
                       min="1"
                       id="createGroupMinimumRequired" />

                <span asp-validation-for="MinimumRequired"
                      class="text-danger small">
                </span>

            </div>

            <div class="col-md-6">

                <label asp-for="DisplayOrder"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="DisplayOrder"
                       class="form-control"
                       type="number"
                       min="0" />

                <span asp-validation-for="DisplayOrder"
                      class="text-danger small">
                </span>

            </div>

            <div class="col-md-6 d-flex align-items-end">

                <div class="form-check form-switch mb-2">

                    <input asp-for="IsActive"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsActive"
                           class="form-check-label fw-semibold">
                    </label>

                </div>

            </div>

        </div>

    </div>

    <div class="modal-footer border-0 pt-0">

        <button type="button"
                class="btn btn-light"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                class="btn text-white"
                style="background:#70461d;">

            <i class="bi bi-check-lg me-1"></i>

            Create Group

        </button>

    </div>

</form>

<script>

    $(function () {

        $('#createGroupSelectionRule').on(
            'change',
            function () {

                if ($(this).val() === 'ALL') {

                    $('#createGroupMinimumRequired')
                        .val(1)
                        .prop('readonly', true);

                }
                else {

                    $('#createGroupMinimumRequired')
                        .prop('readonly', false);

                }

            });

        $('#createGroupSelectionRule').trigger('change');

        $('#createRequirementGroupForm').on(
            'submit',
            function (event) {

                event.preventDefault();

                const form = $(this);

                if (!this.checkValidity()) {

                    this.classList.add('was-validated');

                    return;
                }

                $.ajax({

                    url: form.attr('action'),

                    type: 'POST',

                    data: form.serialize(),

                    success: function (response) {

                        if (response.success) {

                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                confirmButtonColor: '#70461d'
                            }).then(function () {

                                $('#createRequirementGroupModal')
                                    .modal('hide');

                                if (typeof loadProgrammeRequirements === 'function') {

                                    loadProgrammeRequirements();

                                }

                            });

                        }
                        else {

                            $('#createRequirementGroupModalBody')
                                .html(response);

                        }

                    },

                    error: function () {

                        Swal.fire({
                            icon: 'error',
                            title: 'Unable to create',
                            text:
                                'The requirement group could not be created.',
                            confirmButtonColor: '#70461d'
                        });

                    }

                });

            });

    });

</script>