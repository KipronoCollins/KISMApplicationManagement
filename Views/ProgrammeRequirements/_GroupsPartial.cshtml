@model IEnumerable<KISMApplicationManagement.Models.ProgrammeRequirementGroup>

@{
    var groups = Model
        .OrderBy(g => g.DisplayOrder)
        .ThenBy(g => g.GroupName)
        .ToList();
}

@if (groups.Any())
{
    foreach (var group in groups)
    {
        <div class="requirement-group-card">

            <div class="d-flex
                        justify-content-between
                        align-items-start
                        gap-3">

                <div class="flex-grow-1">

                    <div class="d-flex
                                align-items-center
                                gap-2
                                flex-wrap">

                        <span class="group-title">
                            @group.GroupName
                        </span>

                        @if (group.SelectionRule == "ANY")
                        {
                            <span class="group-rule group-rule-any">
                                ANY · @group.MinimumRequired required
                            </span>
                        }
                        else
                        {
                            <span class="group-rule group-rule-all">
                                ALL
                            </span>
                        }

                        @if (group.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }

                    </div>

                    @if (!string.IsNullOrWhiteSpace(group.Description))
                    {
                        <div class="small text-muted mt-1">
                            @group.Description
                        </div>
                    }

                </div>

                <div class="dropdown">

                    <button class="btn btn-sm btn-light"
                            type="button"
                            data-bs-toggle="dropdown">

                        <i class="bi bi-three-dots-vertical"></i>

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <button type="button"
                                    class="dropdown-item btn-add-child-group"
                                    data-programme-id="@group.ProgrammeId"
                                    data-parent-group-id="@group.ProgrammeRequirementGroupId">

                                <i class="bi bi-diagram-3 me-2"></i>
                                Add Child Group

                            </button>
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item btn-add-requirement"
                                    data-group-id="@group.ProgrammeRequirementGroupId">

                                <i class="bi bi-plus-lg me-2"></i>
                                Add Requirement

                            </button>
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item btn-view-group"
                                    data-id="@group.ProgrammeRequirementGroupId">

                                <i class="bi bi-eye me-2"></i>
                                View Details

                            </button>
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item btn-edit-group"
                                    data-id="@group.ProgrammeRequirementGroupId">

                                <i class="bi bi-pencil me-2"></i>
                                Edit Group

                            </button>
                        </li>

                        <li>
                            <hr class="dropdown-divider" />
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item btn-toggle-group"
                                    data-id="@group.ProgrammeRequirementGroupId"
                                    data-is-active="@group.IsActive">

                                @if (group.IsActive)
                                {
                                    <i class="bi bi-toggle-off me-2"></i>
                                    <span>Deactivate</span>
                                }
                                else
                                {
                                    <i class="bi bi-toggle-on me-2"></i>
                                    <span>Activate</span>
                                }

                            </button>
                        </li>

                    </ul>

                </div>

            </div>

            <!-- Requirements directly belonging to this group -->
            @if (group.Requirements.Any())
            {
                <div class="mt-3 pt-3 border-top">

                    @foreach (var requirement in group.Requirements
                        .OrderBy(r => r.DisplayOrder)
                        .ThenBy(r => r.RequirementName))
                    {
                        <div class="requirement-row d-flex
                                    justify-content-between
                                    align-items-center
                                    gap-2
                                    py-2
                                    px-2">

                            <div class="small">

                                <span class="fw-semibold">
                                    @requirement.RequirementName
                                </span>

                                @if (!string.IsNullOrWhiteSpace(
                                    requirement.SubjectName))
                                {
                                    <span class="text-muted">
                                        · @requirement.SubjectName
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                                    requirement.ComparisonOperator) ||
                                    !string.IsNullOrWhiteSpace(
                                    requirement.RequiredValue))
                                {
                                    <span class="text-muted">
                                        ·
                                        @requirement.ComparisonOperator
                                        @requirement.RequiredValue
                                    </span>
                                }

                            </div>

                            <div class="d-flex
                                        align-items-center
                                        gap-1">

                                @if (requirement.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                                <button type="button"
                                        class="btn btn-sm btn-light
                                               btn-edit-requirement"
                                        data-id="@requirement.ProgrammeRequirementId"
                                        title="Edit">

                                    <i class="bi bi-pencil"></i>

                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-light
                                               btn-toggle-requirement"
                                        data-id="@requirement.ProgrammeRequirementId"
                                        data-is-active="@requirement.IsActive"
                                        title="Change status">

                                    @if (requirement.IsActive)
                                    {
                                        <i class="bi bi-toggle-off"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-toggle-on"></i>
                                    }

                                </button>

                            </div>

                        </div>
                    }

                </div>
            }

            <!-- Child groups -->
            @if (group.ChildGroups != null &&
                 group.ChildGroups.Any())
            {
                <div class="nested-group mt-3">

                    @await Html.PartialAsync(
                        "_GroupsPartial",
                        group.ChildGroups
                            .OrderBy(g => g.DisplayOrder)
                            .ThenBy(g => g.GroupName))

                </div>
            }

            @if (!group.Requirements.Any() &&
                 (group.ChildGroups == null ||
                  !group.ChildGroups.Any()))
            {
                <div class="small text-muted mt-3 pt-3 border-top">
                    No requirements or child groups have been added yet.
                </div>
            }

        </div>
    }
}
else
{
    <div class="text-center py-4">

        <div class="mb-2"
             style="color:#d800b8;">

            <i class="bi bi-diagram-3 fs-2"></i>

        </div>

        <div class="fw-semibold">
            No requirement groups yet
        </div>

        <div class="small text-muted">
            Click "Add Group" to configure this programme.
        </div>

    </div>
}