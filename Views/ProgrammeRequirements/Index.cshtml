@model IEnumerable<KISMApplicationManagement.Models.Programme>

@{
    ViewData["Title"] = "Programme Requirements";
}

<div class="container-fluid px-0">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Programme Requirements
            </h2>

            <p class="text-muted mb-0">
                Configure admission requirements for each KISM programme.
            </p>
        </div>

    </div>

    <!-- Information -->
    <div class="alert border-0 shadow-sm mb-4"
         style="background:#fff8fe;">

        <div class="d-flex gap-3">

            <div class="fs-4"
                 style="color:#d800b8;">

                <i class="bi bi-info-circle"></i>

            </div>

            <div>

                <div class="fw-bold mb-1">
                    How requirements work
                </div>

                <div class="small text-muted">

                    Requirement groups can contain other requirement groups.

                    For example,
                    <strong>Academic Qualification</strong>
                    can allow
                    <strong>ANY</strong>
                    of several qualification routes.

                    Each route can then require
                    <strong>ALL</strong>
                    of its individual requirements.

                </div>

            </div>

        </div>

    </div>

    <!-- Programme Cards -->
    <div class="row g-4">

        @foreach (var programme in Model)
        {
            <div class="col-xl-6">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-header bg-white border-0 p-4">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-start
                                    gap-3">

                            <div>

                                <div class="d-flex
                                            align-items-center
                                            gap-2 mb-2">

                                    <span class="badge"
                                          style="background:#f4d8f0;
                                                 color:#a90090;">

                                        @programme.ProgrammeCode

                                    </span>

                                    @if (programme.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }

                                </div>

                                <h5 class="fw-bold mb-1">
                                    @programme.ProgrammeName
                                </h5>

                                <small class="text-muted">
                                    @programme.AwardType
                                    ·
                                    @programme.DurationYears
                                    year@(programme.DurationYears == 1 ? "" : "s")
                                </small>

                            </div>

                            <button type="button"
                                    class="btn btn-sm text-white btn-create-group"
                                    data-programme-id="@programme.ProgrammeId"
                                    style="background:#d800b8;">

                                <i class="bi bi-plus-lg me-1"></i>
                                Add Group

                            </button>

                        </div>

                    </div>

                    <div class="card-body px-4 pb-4">

                        <div class="programme-groups"
                             data-programme-id="@programme.ProgrammeId">

                            <div class="text-center py-4 text-muted">

                                <div class="spinner-border spinner-border-sm"
                                     style="color:#d800b8;">
                                </div>

                                <div class="small mt-2">
                                    Loading requirements...
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<!-- ========================================================= -->
<!-- Create Group Modal -->
<!-- ========================================================= -->

<div class="modal fade"
     id="createRequirementGroupModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div id="createRequirementGroupModalBody">
            </div>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- Edit Group Modal -->
<!-- ========================================================= -->

<div class="modal fade"
     id="editRequirementGroupModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div id="editRequirementGroupModalBody">
            </div>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- Group Details Modal -->
<!-- ========================================================= -->

<div class="modal fade"
     id="groupDetailsModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div id="groupDetailsModalBody">
            </div>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- Create Requirement Modal -->
<!-- ========================================================= -->

<div class="modal fade"
     id="createRequirementModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div id="createRequirementModalBody">
            </div>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- Edit Requirement Modal -->
<!-- ========================================================= -->

<div class="modal fade"
     id="editRequirementModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div id="editRequirementModalBody">
            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // =========================================================
        // Loading
        // =========================================================

        function loadProgrammeRequirements() {

            $('.programme-groups').each(function () {

                const container = $(this);

                const programmeId =
                    container.data('programme-id');

                loadGroupsForProgramme(
                    programmeId,
                    container);
            });
        }

        function loadGroupsForProgramme(
            programmeId,
            container) {

            container.html(
                '<div class="text-center py-4">' +
                '<div class="spinner-border spinner-border-sm" ' +
                'style="color:#d800b8;"></div>' +
                '<div class="small text-muted mt-2">' +
                'Loading...' +
                '</div>' +
                '</div>'
            );

            $.get(
                '@Url.Action("GetGroups", "ProgrammeRequirements")',
                {
                    programmeId: programmeId
                })
                .done(function (html) {

                    container.html(html);

                })
                .fail(function () {

                    container.html(
                        '<div class="alert alert-danger mb-0">' +
                        'Unable to load requirement groups.' +
                        '</div>'
                    );

                });
        }

        // =========================================================
        // Create Group
        // =========================================================

        function openCreateGroupModal(
            programmeId,
            parentGroupId) {

            $('#createRequirementGroupModalBody')
                .html(
                    '<div class="text-center py-5">' +
                    '<div class="spinner-border" ' +
                    'style="color:#d800b8;"></div>' +
                    '<div class="mt-3 text-muted">' +
                    'Loading...' +
                    '</div>' +
                    '</div>'
                );

            $('#createRequirementGroupModal')
                .modal('show');

            const requestData = {
                programmeId: programmeId
            };

            if (parentGroupId) {
                requestData.parentGroupId = parentGroupId;
            }

            $.get(
                '@Url.Action("CreateGroup", "ProgrammeRequirements")',
                requestData)
                .done(function (html) {

                    $('#createRequirementGroupModalBody')
                        .html(html);

                })
                .fail(function () {

                    $('#createRequirementGroupModalBody')
                        .html(
                            '<div class="alert alert-danger m-4">' +
                            'The requirement group form could not be loaded.' +
                            '</div>'
                        );

                });
        }

        $(document).on(
            'click',
            '.btn-create-group',
            function () {

                const programmeId =
                    $(this).data('programme-id');

                openCreateGroupModal(
                    programmeId,
                    null);
            });

        $(document).on(
            'click',
            '.btn-add-child-group',
            function () {

                const programmeId =
                    $(this).data('programme-id');

                const parentGroupId =
                    $(this).data('parent-group-id');

                openCreateGroupModal(
                    programmeId,
                    parentGroupId);
            });

        // =========================================================
        // Edit Group
        // =========================================================

        $(document).on(
            'click',
            '.btn-edit-group',
            function () {

                const id =
                    $(this).data('id');

                $('#editRequirementGroupModalBody')
                    .html(
                        '<div class="text-center py-5">' +
                        '<div class="spinner-border" ' +
                        'style="color:#d800b8;"></div>' +
                        '<div class="mt-3 text-muted">' +
                        'Loading...' +
                        '</div>' +
                        '</div>'
                    );

                $('#editRequirementGroupModal')
                    .modal('show');

                $.get(
                    '@Url.Action("EditGroup", "ProgrammeRequirements")',
                    {
                        id: id
                    })
                    .done(function (html) {

                        $('#editRequirementGroupModalBody')
                            .html(html);

                    })
                    .fail(function () {

                        $('#editRequirementGroupModalBody')
                            .html(
                                '<div class="alert alert-danger m-4">' +
                                'The requirement group form could not be loaded.' +
                                '</div>'
                            );

                    });
            });

        // =========================================================
        // Group Details
        // =========================================================

        $(document).on(
            'click',
            '.btn-view-group',
            function () {

                const id =
                    $(this).data('id');

                $('#groupDetailsModalBody')
                    .html(
                        '<div class="text-center py-5">' +
                        '<div class="spinner-border" ' +
                        'style="color:#d800b8;"></div>' +
                        '<div class="mt-3 text-muted">' +
                        'Loading...' +
                        '</div>' +
                        '</div>'
                    );

                $('#groupDetailsModal')
                    .modal('show');

                $.get(
                    '@Url.Action("GroupDetails", "ProgrammeRequirements")',
                    {
                        id: id
                    })
                    .done(function (html) {

                        $('#groupDetailsModalBody')
                            .html(html);

                    })
                    .fail(function () {

                        $('#groupDetailsModalBody')
                            .html(
                                '<div class="alert alert-danger m-4">' +
                                'Unable to load group details.' +
                                '</div>'
                            );

                    });
            });

        // =========================================================
        // Toggle Group
        // =========================================================

        $(document).on(
            'click',
            '.btn-toggle-group',
            function () {

                const button =
                    $(this);

                const id =
                    button.data('id');

                const isActive =
                    button.data('is-active') === true ||
                    button.data('is-active') === 'true';

                Swal.fire({
                    icon: 'question',
                    title: isActive
                        ? 'Deactivate group?'
                        : 'Activate group?',
                    text: isActive
                        ? 'This group and its child groups will no longer be active.'
                        : 'This requirement group will become active.',
                    showCancelButton: true,
                    confirmButtonColor: '#d800b8',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText:
                        isActive
                            ? 'Yes, deactivate'
                            : 'Yes, activate'
                }).then(function (result) {

                    if (!result.isConfirmed) {
                        return;
                    }

                    const token =
                        $('input[name="__RequestVerificationToken"]')
                            .first()
                            .val();

                    $.ajax({
                        url:
                            '@Url.Action("ToggleGroupStatus", "ProgrammeRequirements")',

                        type: 'POST',

                        data: {
                            id: id,
                            __RequestVerificationToken:
                                token
                        },

                        success: function (response) {

                            if (response.success) {

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success',
                                    text: response.message,
                                    confirmButtonColor:
                                        '#d800b8'
                                }).then(function () {

                                    loadProgrammeRequirements();

                                });

                            }
                            else {

                                Swal.fire({
                                    icon: 'error',
                                    title: 'Unable to update',
                                    text: response.message,
                                    confirmButtonColor:
                                        '#d800b8'
                                });

                            }

                        },

                        error: function () {

                            Swal.fire({
                                icon: 'error',
                                title: 'Unable to update',
                                text:
                                    'The group status could not be changed.',
                                confirmButtonColor:
                                    '#d800b8'
                            });

                        }
                    });

                });

            });

        // =========================================================
        // Create Requirement
        // =========================================================

        $(document).on(
            'click',
            '.btn-add-requirement',
            function () {

                const groupId =
                    $(this).data('group-id');

                $('#createRequirementModalBody')
                    .html(
                        '<div class="text-center py-5">' +
                        '<div class="spinner-border" ' +
                        'style="color:#d800b8;"></div>' +
                        '<div class="mt-3 text-muted">' +
                        'Loading...' +
                        '</div>' +
                        '</div>'
                    );

                $('#createRequirementModal')
                    .modal('show');

                $.get(
                    '@Url.Action("CreateRequirement", "ProgrammeRequirements")',
                    {
                        programmeRequirementGroupId:
                            groupId
                    })
                    .done(function (html) {

                        $('#createRequirementModalBody')
                            .html(html);

                    })
                    .fail(function () {

                        $('#createRequirementModalBody')
                            .html(
                                '<div class="alert alert-danger m-4">' +
                                'Unable to load the requirement form.' +
                                '</div>'
                            );

                    });
            });

        // =========================================================
        // Edit Requirement
        // =========================================================

        $(document).on(
            'click',
            '.btn-edit-requirement',
            function () {

                const id =
                    $(this).data('id');

                $('#editRequirementModalBody')
                    .html(
                        '<div class="text-center py-5">' +
                        '<div class="spinner-border" ' +
                        'style="color:#d800b8;"></div>' +
                        '<div class="mt-3 text-muted">' +
                        'Loading...' +
                        '</div>' +
                        '</div>'
                    );

                $('#editRequirementModal')
                    .modal('show');

                $.get(
                    '@Url.Action("EditRequirement", "ProgrammeRequirements")',
                    {
                        id: id
                    })
                    .done(function (html) {

                        $('#editRequirementModalBody')
                            .html(html);

                    })
                    .fail(function () {

                        $('#editRequirementModalBody')
                            .html(
                                '<div class="alert alert-danger m-4">' +
                                'The requirement form could not be loaded.' +
                                '</div>'
                            );

                    });
            });

        // =========================================================
        // Toggle Requirement
        // =========================================================

        $(document).on(
            'click',
            '.btn-toggle-requirement',
            function () {

                const button =
                    $(this);

                const id =
                    button.data('id');

                const isActive =
                    button.data('is-active') === true ||
                    button.data('is-active') === 'true';

                Swal.fire({
                    icon: 'question',
                    title: isActive
                        ? 'Deactivate requirement?'
                        : 'Activate requirement?',
                    text: isActive
                        ? 'This requirement will no longer be active.'
                        : 'This requirement will become active.',
                    showCancelButton: true,
                    confirmButtonColor: '#d800b8',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText:
                        isActive
                            ? 'Yes, deactivate'
                            : 'Yes, activate'
                }).then(function (result) {

                    if (!result.isConfirmed) {
                        return;
                    }

                    const token =
                        $('input[name="__RequestVerificationToken"]')
                            .first()
                            .val();

                    $.ajax({
                        url:
                            '@Url.Action("ToggleRequirementStatus", "ProgrammeRequirements")',

                        type: 'POST',

                        data: {
                            id: id,
                            __RequestVerificationToken:
                                token
                        },

                        success: function (response) {

                            if (response.success) {

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success',
                                    text: response.message,
                                    confirmButtonColor:
                                        '#d800b8'
                                }).then(function () {

                                    loadProgrammeRequirements();

                                });

                            }
                            else {

                                Swal.fire({
                                    icon: 'error',
                                    title: 'Unable to update',
                                    text: response.message,
                                    confirmButtonColor:
                                        '#d800b8'
                                });

                            }

                        },

                        error: function () {

                            Swal.fire({
                                icon: 'error',
                                title: 'Unable to update',
                                text:
                                    'The requirement status could not be changed.',
                                confirmButtonColor:
                                    '#d800b8'
                            });

                        }
                    });

                });

            });

        // =========================================================
        // Initial Load
        // =========================================================

        $(function () {

            loadProgrammeRequirements();

        });

    </script>

    <style>

        .programme-groups .requirement-group-card {
            border: 1px solid #eeeeee;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 12px;
            background: #ffffff;
        }

        .programme-groups .requirement-group-card:hover {
            border-color: #ead7e7;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
        }

        .programme-groups .nested-group {
            margin-left: 24px;
            border-left: 3px solid #f0d8ed;
            padding-left: 15px;
        }

        .programme-groups .group-title {
            font-weight: 700;
            color: #292929;
        }

        .programme-groups .group-rule {
            font-size: .78rem;
            font-weight: 600;
        }

        .programme-groups .group-rule-all {
            color: #0d6efd;
        }

        .programme-groups .group-rule-any {
            color: #d800b8;
        }

        .programme-groups .requirement-row {
            border-radius: 8px;
        }

        .programme-groups .requirement-row:hover {
            background: #faf7fa;
        }

    </style>

}