@model KISMApplicationManagement.Models.ProgrammeRequirement

<form id="editRequirementForm"
      asp-action="EditRequirement"
      asp-controller="ProgrammeRequirements"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="ProgrammeRequirementId" />

    <input type="hidden"
           asp-for="ProgrammeRequirementGroupId" />

    <div class="modal-header border-0 pb-0">

        <div>

            <h5 class="modal-title fw-bold">

                <i class="bi bi-pencil-square me-2"
                   style="color:#70461d;"></i>

                Edit Requirement

            </h5>

            <small class="text-muted">
                @ViewBag.GroupName
            </small>

        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>

    </div>

    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="mb-3">

            <label asp-for="RequirementType"
                   class="form-label fw-semibold">
            </label>

            <select asp-for="RequirementType"
                    class="form-select">

                <option value="OverallGrade">
                    Overall Grade
                </option>

                <option value="SubjectGrade">
                    Subject Grade
                </option>

                <option value="Document">
                    Document
                </option>

                <option value="Age">
                    Age
                </option>

                <option value="Other">
                    Other
                </option>

            </select>

        </div>

        <div class="mb-3">

            <label asp-for="RequirementName"
                   class="form-label fw-semibold">
            </label>

            <input asp-for="RequirementName"
                   class="form-control" />

            <span asp-validation-for="RequirementName"
                  class="text-danger small">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="SubjectName"
                   class="form-label fw-semibold">
            </label>

            <input asp-for="SubjectName"
                   class="form-control" />

        </div>

        <div class="row g-3">

            <div class="col-md-6">

                <label asp-for="ComparisonOperator"
                       class="form-label fw-semibold">
                </label>

                <select asp-for="ComparisonOperator"
                        class="form-select">

                    <option value="">
                        Select operator
                    </option>

                    <option value=">=">
                        Greater than or equal to
                    </option>

                    <option value=">">
                        Greater than
                    </option>

                    <option value="=">
                        Equal to
                    </option>

                    <option value="<=">
                        Less than or equal to
                    </option>

                    <option value="Required">
                        Required
                    </option>

                </select>

            </div>

            <div class="col-md-6">

                <label asp-for="RequiredValue"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="RequiredValue"
                       class="form-control" />

            </div>

        </div>

        <div class="mb-3 mt-3">

            <label asp-for="Description"
                   class="form-label fw-semibold">
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="3"></textarea>

        </div>

        <div class="row g-3">

            <div class="col-md-6">

                <label asp-for="DisplayOrder"
                       class="form-label fw-semibold">
                </label>

                <input asp-for="DisplayOrder"
                       class="form-control"
                       type="number"
                       min="0" />

            </div>

            <div class="col-md-6 d-flex align-items-end">

                <div class="form-check form-switch mb-2">

                    <input asp-for="IsActive"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsActive"
                           class="form-check-label fw-semibold">
                    </label>

                </div>

            </div>

        </div>

    </div>

    <div class="modal-footer border-0 pt-0">

        <button type="button"
                class="btn btn-light"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                class="btn text-white"
                style="background:#70461d;">

            <i class="bi bi-check-lg me-1"></i>

            Save Changes

        </button>

    </div>

</form>

<script>

    $(function () {

        $('#editRequirementForm').on(
            'submit',
            function (event) {

                event.preventDefault();

                const form = $(this);

                if (!this.checkValidity()) {

                    this.classList.add('was-validated');

                    return;
                }

                $.ajax({

                    url: form.attr('action'),

                    type: 'POST',

                    data: form.serialize(),

                    success: function (response) {

                        if (response.success) {

                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                                confirmButtonColor: '#70461d'
                            }).then(function () {

                                $('#editRequirementModal')
                                    .modal('hide');

                                if (typeof loadProgrammeRequirements === 'function') {

                                    loadProgrammeRequirements();

                                }

                            });

                        }
                        else {

                            $('#editRequirementModalBody')
                                .html(response);

                        }

                    },

                    error: function () {

                        Swal.fire({
                            icon: 'error',
                            title: 'Unable to update',
                            text:
                                'The requirement could not be updated.',
                            confirmButtonColor: '#70461d'
                        });

                    }

                });

            });

    });

</script>