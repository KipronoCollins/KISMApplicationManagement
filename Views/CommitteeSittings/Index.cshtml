@model IEnumerable<KISMApplicationManagement.Models.CommitteeSitting>

@{
    ViewData["Title"] = "Committee Sittings";
}

<div class="container-fluid px-0">

    <!-- =========================================================
         Header
         ========================================================= -->

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Committee Sittings
            </h2>

            <p class="text-muted mb-0">
                Schedule and manage committee sessions for application review.
            </p>
        </div>

        <div>
            <button type="button"
                    class="btn text-white"
                    id="btnCreateCommitteeSitting"
                    style="background:#70461d;">

                <i class="bi bi-plus-lg me-1"></i>
                Add Committee Sitting

            </button>
        </div>

    </div>


    <!-- =========================================================
         Information
         ========================================================= -->

    <div class="alert border-0 shadow-sm mb-4"
         style="background:#fff8fe;">

        <div class="d-flex gap-3">

            <div class="fs-4"
                 style="color:#70461d;">

                <i class="bi bi-people"></i>

            </div>

            <div>

                <div class="fw-bold mb-1">
                    Committee sitting management
                </div>

                <div class="small text-muted">

                    Create committee sessions, select applications
                    for review, conduct the committee workbench session,
                    and record collective committee decisions.

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         Committee Sitting Table
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table id="committeeSittingsTable"
                       class="table table-hover align-middle w-100">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>
                                Reference
                            </th>

                            <th>
                                Intake
                            </th>

                            <th>
                                Sitting Date
                            </th>

                            <th>
                                Applications
                            </th>

                            <th>
                                Decisions
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            var rowNumber = 1;
                        }

                        @foreach (var sitting in Model)
                        {
                            var applicationCount =
                                sitting.Applications?.Count ?? 0;

                            var decisionCount =
                                sitting.Applications?
                                    .Count(application =>
                                        application.Decision != null)
                                    ?? 0;

                            <tr data-sitting-id="@sitting.CommitteeSittingId">

                                <!-- Number -->

                                <td>
                                    @rowNumber
                                </td>


                                <!-- Reference -->

                                <td>

                                    <div class="fw-semibold">

                                        @sitting.ReferenceNumber

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(sitting.Remarks))
                                    {
                                        <div class="small text-muted text-truncate"
                                             style="max-width:260px;">

                                            @sitting.Remarks

                                        </div>
                                    }

                                </td>


                                <!-- Intake -->

                                <td>

                                    <div class="fw-semibold">

                                        @sitting.Intake?.IntakeName

                                    </div>

                                    @if (sitting.Intake != null)
                                    {
                                        <div class="small text-muted">

                                            @sitting.Intake.AcademicYear
                                            ·
                                            @sitting.Intake.IntakePeriod

                                        </div>
                                    }

                                </td>


                                <!-- Sitting Date -->

                                <td>

                                    <span class="fw-semibold">

                                        @sitting.SittingDate.ToString("dd MMM yyyy")

                                    </span>

                                </td>


                                <!-- Applications -->

                                <td class="applications-count-cell">

                                    @if (applicationCount > 0)
                                    {
                                        <span class="badge"
                                              style="background:#f4d8f0;
                                                     color:#a90090;">

                                            <i class="bi bi-file-earmark-text me-1"></i>

                                            @applicationCount

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            0

                                        </span>
                                    }

                                </td>


                                <!-- Decisions -->

                                <td class="decisions-count-cell">

                                    @if (decisionCount > 0)
                                    {
                                        <span class="badge bg-success">

                                            @decisionCount / @applicationCount

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            0 / @applicationCount

                                        </span>
                                    }

                                </td>


                                <!-- Status -->

                                <td class="sitting-status-cell">

                                    @if (sitting.Status ==
                                        KISMApplicationManagement.Constants.CommitteeSittingStatuses.Scheduled)
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-calendar-event me-1"></i>

                                            Scheduled

                                        </span>
                                    }
                                    else if (sitting.Status ==
                                        KISMApplicationManagement.Constants.CommitteeSittingStatuses.InProgress)
                                    {
                                        <span class="badge bg-primary">

                                            <i class="bi bi-play-circle me-1"></i>

                                            In Progress

                                        </span>
                                    }
                                    else if (sitting.Status ==
                                        KISMApplicationManagement.Constants.CommitteeSittingStatuses.Completed)
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Completed

                                        </span>
                                    }
                                    else if (sitting.Status ==
                                        KISMApplicationManagement.Constants.CommitteeSittingStatuses.Cancelled)
                                    {
                                        <span class="badge bg-secondary">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Cancelled

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            @sitting.Status

                                        </span>
                                    }

                                </td>


                                <!-- Actions -->

                                <td>

                                    <div class="d-flex gap-1">

                                        <!-- Details -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary btn-details-committee-sitting"
                                                data-id="@sitting.CommitteeSittingId"
                                                title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </button>


                                        @if (sitting.Status ==
                                            KISMApplicationManagement.Constants.CommitteeSittingStatuses.Scheduled)
                                        {
                                            <!-- Edit -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary btn-edit-committee-sitting"
                                                    data-id="@sitting.CommitteeSittingId"
                                                    title="Edit Sitting">

                                                <i class="bi bi-pencil"></i>

                                            </button>


                                            <!-- Manage Applications -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success btn-manage-committee-sitting"
                                                    data-id="@sitting.CommitteeSittingId"
                                                    title="Manage Applications">

                                                <i class="bi bi-files"></i>

                                            </button>


                                            <!-- Start -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary btn-start-committee-sitting"
                                                    data-id="@sitting.CommitteeSittingId"
                                                    title="Start Sitting">

                                                <i class="bi bi-play-fill"></i>

                                            </button>


                                            <!-- Cancel -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-cancel-committee-sitting"
                                                    data-id="@sitting.CommitteeSittingId"
                                                    title="Cancel Sitting">

                                                <i class="bi bi-x-lg"></i>

                                            </button>
                                        }
                                        else if (sitting.Status ==
                                            KISMApplicationManagement.Constants.CommitteeSittingStatuses.InProgress)
                                        {
                                            <!-- Workbench -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success btn-manage-committee-sitting"
                                                    data-id="@sitting.CommitteeSittingId"
                                                    title="Open Committee Workbench">

                                                <i class="bi bi-display"></i>

                                            </button>


                                            <!-- Cancel -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-cancel-committee-sitting"
                                                    data-id="@sitting.CommitteeSittingId"
                                                    title="Cancel Sitting">

                                                <i class="bi bi-x-lg"></i>

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>

                            rowNumber++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     Create Committee Sitting Modal
     ========================================================= -->

<div class="modal fade"
     id="createCommitteeSittingModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div id="createCommitteeSittingModalBody">
            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     Edit Committee Sitting Modal
     ========================================================= -->

<div class="modal fade"
     id="editCommitteeSittingModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div id="editCommitteeSittingModalBody">
            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     Details Modal
     ========================================================= -->

<div class="modal fade"
     id="detailsCommitteeSittingModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div id="detailsCommitteeSittingModalBody">
            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     Anti Forgery Token
     ========================================================= -->

<form id="committeeSittingAntiForgeryForm"
      class="d-none">

    @Html.AntiForgeryToken()

</form>


@section Scripts {

    <script>

        // =========================================================
        // DataTable
        // =========================================================

        $(function () {

            $('#committeeSittingsTable').DataTable({

                responsive: true,

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, 'All']
                ],

                order: [
                    [3, 'desc']
                ],

                columnDefs: [

                    {
                        targets: 7,
                        orderable: false,
                        searchable: false
                    }

                ],

                language: {

                    emptyTable:
                        'No committee sittings have been created yet.'

                }

            });

        });


        // =========================================================
        // Create Committee Sitting
        // =========================================================

        $('#btnCreateCommitteeSitting').on(
            'click',
            function () {

                $('#createCommitteeSittingModalBody')
                    .html(

                        '<div class="text-center py-5">' +

                        '<div class="spinner-border" ' +
                        'style="color:#70461d;"></div>' +

                        '<div class="mt-3 text-muted">' +

                        'Loading committee sitting form...' +

                        '</div>' +

                        '</div>'

                    );

                $('#createCommitteeSittingModal')
                    .modal('show');

                $.get(

                    '@Url.Action("Create", "CommitteeSittings")'

                )

                .done(function (html) {

                    $('#createCommitteeSittingModalBody')
                        .html(html);

                })

                .fail(function () {

                    $('#createCommitteeSittingModalBody')
                        .html(

                            '<div class="alert alert-danger m-4">' +

                            'The committee sitting form could not be loaded.' +

                            '</div>'

                        );

                });

            });


        // =========================================================
        // Edit Committee Sitting
        // =========================================================

        $(document).on(

            'click',

            '.btn-edit-committee-sitting',

            function () {

                const id =
                    $(this).data('id');

                $('#editCommitteeSittingModalBody')
                    .html(

                        '<div class="text-center py-5">' +

                        '<div class="spinner-border" ' +
                        'style="color:#70461d;"></div>' +

                        '<div class="mt-3 text-muted">' +

                        'Loading committee sitting...' +

                        '</div>' +

                        '</div>'

                    );

                $('#editCommitteeSittingModal')
                    .modal('show');

                $.get(

                    '@Url.Action("Edit", "CommitteeSittings")',

                    {
                        id: id
                    }

                )

                .done(function (html) {

                    $('#editCommitteeSittingModalBody')
                        .html(html);

                })

                .fail(function (xhr) {

                    let message =
                        'The committee sitting could not be loaded.';

                    if (xhr.responseText) {

                        message =
                            xhr.responseText;

                    }

                    $('#editCommitteeSittingModalBody')
                        .html(

                            '<div class="alert alert-danger m-4">' +

                            message +

                            '</div>'

                        );

                });

            });


        // =========================================================
        // Committee Sitting Details
        // =========================================================

        $(document).on(

            'click',

            '.btn-details-committee-sitting',

            function () {

                const id =
                    $(this).data('id');

                $('#detailsCommitteeSittingModalBody')
                    .html(

                        '<div class="text-center py-5">' +

                        '<div class="spinner-border" ' +
                        'style="color:#70461d;"></div>' +

                        '<div class="mt-3 text-muted">' +

                        'Loading committee sitting details...' +

                        '</div>' +

                        '</div>'

                    );

                $('#detailsCommitteeSittingModal')
                    .modal('show');

                $.get(

                    '@Url.Action("Details", "CommitteeSittings")',

                    {
                        id: id
                    }

                )

                .done(function (html) {

                    $('#detailsCommitteeSittingModalBody')
                        .html(html);

                })

                .fail(function () {

                    $('#detailsCommitteeSittingModalBody')
                        .html(

                            '<div class="alert alert-danger m-4">' +

                            'Unable to load committee sitting details.' +

                            '</div>'

                        );

                });

            });


        // =========================================================
        // Manage Committee Sitting
        // =========================================================

        $(document).on(

            'click',

            '.btn-manage-committee-sitting',

            function () {

                const id =
                    $(this).data('id');

                window.location.href =
                    '@Url.Action("Manage", "CommitteeSittings")' +
                    '?id=' +
                    id;

            });


        // =========================================================
        // Start Committee Sitting
        // =========================================================

        $(document).on(

            'click',

            '.btn-start-committee-sitting',

            function () {

                const button =
                    $(this);

                const id =
                    button.data('id');

                Swal.fire({

                    icon: 'question',

                    title:
                        'Start committee sitting?',

                    text:
                        'The sitting will move to In Progress and the committee workbench will become available.',

                    showCancelButton: true,

                    confirmButtonColor:
                        '#70461d',

                    cancelButtonColor:
                        '#6c757d',

                    confirmButtonText:
                        'Yes, start sitting'

                })

                .then(function (result) {

                    if (!result.isConfirmed) {

                        return;

                    }

                    const token =
                        $('#committeeSittingAntiForgeryForm')
                            .find(
                                'input[name="__RequestVerificationToken"]'
                            )
                            .val();

                    $.ajax({

                        url:
                            '@Url.Action("Start", "CommitteeSittings")',

                        type:
                            'POST',

                        data: {

                            id:
                                id,

                            __RequestVerificationToken:
                                token

                        },

                        success:
                            function (response) {

                                if (!response.success) {

                                    Swal.fire({

                                        icon:
                                            'error',

                                        title:
                                            'Unable to start sitting',

                                        text:
                                            response.message,

                                        confirmButtonColor:
                                            '#70461d'

                                    });

                                    return;

                                }

                                Swal.fire({

                                    icon:
                                        'success',

                                    title:
                                        'Sitting started',

                                    text:
                                        response.message,

                                    confirmButtonColor:
                                        '#70461d'

                                })

                                .then(function () {

                                    window.location.reload();

                                });

                            },

                        error:
                            function (xhr) {

                                let message =
                                    'The committee sitting could not be started.';

                                if (
                                    xhr.responseJSON &&
                                    xhr.responseJSON.message
                                ) {

                                    message =
                                        xhr.responseJSON.message;

                                }

                                Swal.fire({

                                    icon:
                                        'error',

                                    title:
                                        'Unable to start sitting',

                                    text:
                                        message,

                                    confirmButtonColor:
                                        '#70461d'

                                });

                            }

                    });

                });

            });


        // =========================================================
        // Cancel Committee Sitting
        // =========================================================

        $(document).on(

            'click',

            '.btn-cancel-committee-sitting',

            function () {

                const button =
                    $(this);

                const id =
                    button.data('id');

                Swal.fire({

                    icon:
                        'warning',

                    title:
                        'Cancel committee sitting?',

                    text:
                        'The sitting will be marked as cancelled and will no longer be available for committee processing.',

                    showCancelButton:
                        true,

                    confirmButtonColor:
                        '#70461d',

                    cancelButtonColor:
                        '#6c757d',

                    confirmButtonText:
                        'Yes, cancel sitting'

                })

                .then(function (result) {

                    if (!result.isConfirmed) {

                        return;

                    }

                    const token =
                        $('#committeeSittingAntiForgeryForm')
                            .find(
                                'input[name="__RequestVerificationToken"]'
                            )
                            .val();

                    $.ajax({

                        url:
                            '@Url.Action("Cancel", "CommitteeSittings")',

                        type:
                            'POST',

                        data: {

                            id:
                                id,

                            __RequestVerificationToken:
                                token

                        },

                        success:
                            function (response) {

                                if (!response.success) {

                                    Swal.fire({

                                        icon:
                                            'error',

                                        title:
                                            'Unable to cancel sitting',

                                        text:
                                            response.message,

                                        confirmButtonColor:
                                            '#70461d'

                                    });

                                    return;

                                }

                                Swal.fire({

                                    icon:
                                        'success',

                                    title:
                                        'Sitting cancelled',

                                    text:
                                        response.message,

                                    confirmButtonColor:
                                        '#70461d'

                                })

                                .then(function () {

                                    window.location.reload();

                                });

                            },

                        error:
                            function (xhr) {

                                let message =
                                    'The committee sitting could not be cancelled.';

                                if (
                                    xhr.responseJSON &&
                                    xhr.responseJSON.message
                                ) {

                                    message =
                                        xhr.responseJSON.message;

                                }

                                Swal.fire({

                                    icon:
                                        'error',

                                    title:
                                        'Unable to cancel sitting',

                                    text:
                                        message,

                                    confirmButtonColor:
                                        '#70461d'

                                });

                            }

                    });

                });

            });

    </script>


    <style>

        #committeeSittingsTable thead th {
            white-space: nowrap;
        }

        #committeeSittingsTable tbody td {
            vertical-align: middle;
        }

        #committeeSittingsTable .btn {
            min-width: 34px;
        }

        .modal-content {
            overflow: hidden;
        }

    </style>

}