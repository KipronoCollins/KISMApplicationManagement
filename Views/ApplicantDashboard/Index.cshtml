@model KISMApplicationManagement.Models.ApplicantDashboardViewModels.ApplicantDashboardViewModel

@{
    ViewData["Title"] = "Applicant Dashboard";
}

<div class="container-fluid px-0">

    <!-- ========================================================= -->
    <!-- Welcome Header -->
    <!-- ========================================================= -->

    <div class="dashboard-welcome mb-4">

        <div>

            <div class="welcome-icon">
                <i class="bi bi-grid-1x2-fill"></i>
            </div>

            <div class="mt-3">

                <h1 class="h3 fw-bold mb-1">
                    Welcome, @Model.FirstName
                </h1>

                <p class="text-muted mb-0">
                    Manage your KISM application from your applicant portal.
                </p>

            </div>

        </div>

        <div class="welcome-logo">

            <img src="https://kism.ac.ke/wp-content/uploads/2021/07/new.png"
                 alt="KISM"
                 class="img-fluid" />

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- Profile Alert -->
    <!-- ========================================================= -->

    @if (!Model.ProfileComplete)
    {
        <div class="profile-alert mb-4">

            <div class="profile-alert-icon">
                <i class="bi bi-exclamation-circle-fill"></i>
            </div>

            <div class="flex-grow-1">

                <div class="fw-bold mb-1">
                    Complete your applicant profile
                </div>

                <div class="small text-muted">
                    Please complete your personal and location information
                    before starting your application.
                </div>

            </div>

            <a asp-controller="ApplicantProfile"
               asp-action="Index"
               class="btn btn-kism-primary">

                <i class="bi bi-person-vcard me-2"></i>

                Complete Profile

            </a>

        </div>
    }


    <!-- ========================================================= -->
    <!-- Summary Cards -->
    <!-- ========================================================= -->

    <div class="row g-4 mb-4">

        <!-- Application -->
        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon application-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <div class="summary-content">

                    <div class="summary-label">
                        Application
                    </div>

                    <div class="summary-value">
                        Not Started
                    </div>

                    <div class="summary-description">
                        No application submitted
                    </div>

                </div>

            </div>

        </div>


        <!-- Documents -->
        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon document-icon">
                    <i class="bi bi-folder2-open"></i>
                </div>

                <div class="summary-content">

                    <div class="summary-label">
                        Documents
                    </div>

                    <div class="summary-value">
                        0
                    </div>

                    <div class="summary-description">
                        Documents uploaded
                    </div>

                </div>

            </div>

        </div>


        <!-- Payments -->
        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon payment-icon">
                    <i class="bi bi-credit-card"></i>
                </div>

                <div class="summary-content">

                    <div class="summary-label">
                        Payments
                    </div>

                    <div class="summary-value">
                        0
                    </div>

                    <div class="summary-description">
                        Payments made
                    </div>

                </div>

            </div>

        </div>


        <!-- Profile -->
        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon profile-icon">
                    <i class="bi bi-person-check"></i>
                </div>

                <div class="summary-content">

                    <div class="summary-label">
                        Profile
                    </div>

                    <div class="summary-value">

                        @(Model.ProfileComplete
                            ? "Complete"
                            : "Incomplete")

                    </div>

                    <div class="summary-description">
                        Applicant information
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- Application Section -->
        <!-- ===================================================== -->

        <div class="col-lg-8">

            <div class="dashboard-card h-100">

                <div class="dashboard-card-header">

                    <div>

                        <h5 class="fw-bold mb-1">
                            My Application
                        </h5>

                        <small class="text-muted">
                            Track and manage your admission application
                        </small>

                    </div>

                    <span class="status-badge status-not-started">
                        Not Started
                    </span>

                </div>


                <div class="dashboard-card-body">

                    <div class="empty-state">

                        <div class="empty-state-icon">
                            <i class="bi bi-file-earmark-plus"></i>
                        </div>

                        <h5 class="fw-bold mt-3 mb-2">
                            Start your KISM application
                        </h5>

                        <p class="text-muted mb-4">
                            Your application has not been started yet.
                            Complete your profile and begin your application
                            when you are ready.
                        </p>

                        @if (Model.ProfileComplete)
                        {
                            <a href="#"
                               class="btn btn-kism-primary">

                                <i class="bi bi-plus-circle me-2"></i>

                                Start Application

                            </a>
                        }
                        else
                        {
                            <a asp-controller="ApplicantProfile"
                               asp-action="Index"
                               class="btn btn-kism-primary">

                                <i class="bi bi-person-vcard me-2"></i>

                                Complete Profile First

                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- Quick Actions -->
        <!-- ===================================================== -->

        <div class="col-lg-4">

            <div class="dashboard-card h-100">

                <div class="dashboard-card-header">

                    <div>

                        <h5 class="fw-bold mb-1">
                            Quick Actions
                        </h5>

                        <small class="text-muted">
                            Frequently used applicant services
                        </small>

                    </div>

                </div>


                <div class="dashboard-card-body p-3">

                    <div class="quick-actions">

                        <!-- Profile -->

                        <a asp-controller="ApplicantProfile"
                           asp-action="Index"
                           class="quick-action">

                            <span class="quick-action-icon">
                                <i class="bi bi-person-vcard"></i>
                            </span>

                            <span class="quick-action-content">

                                <strong>
                                    My Profile
                                </strong>

                                <small>
                                    Update personal information
                                </small>

                            </span>

                            <i class="bi bi-chevron-right"></i>

                        </a>


                        <!-- Applications -->

                        <a href="#"
                           class="quick-action">

                            <span class="quick-action-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </span>

                            <span class="quick-action-content">

                                <strong>
                                    My Applications
                                </strong>

                                <small>
                                    View application history
                                </small>

                            </span>

                            <i class="bi bi-chevron-right"></i>

                        </a>


                        <!-- Documents -->

                        <a href="#"
                           class="quick-action">

                            <span class="quick-action-icon">
                                <i class="bi bi-folder2-open"></i>
                            </span>

                            <span class="quick-action-content">

                                <strong>
                                    My Documents
                                </strong>

                                <small>
                                    Manage uploaded documents
                                </small>

                            </span>

                            <i class="bi bi-chevron-right"></i>

                        </a>


                        <!-- Payments -->

                        <a href="#"
                           class="quick-action">

                            <span class="quick-action-icon">
                                <i class="bi bi-credit-card"></i>
                            </span>

                            <span class="quick-action-content">

                                <strong>
                                    My Payments
                                </strong>

                                <small>
                                    View payment information
                                </small>

                            </span>

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- Applicant Information -->
        <!-- ===================================================== -->

        <div class="col-lg-8">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <div>

                        <h5 class="fw-bold mb-1">
                            Applicant Information
                        </h5>

                        <small class="text-muted">
                            Your registered account information
                        </small>

                    </div>

                    <a asp-controller="ApplicantProfile"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-kism">

                        <i class="bi bi-pencil me-1"></i>

                        Edit Profile

                    </a>

                </div>


                <div class="dashboard-card-body">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="info-label">
                                Full Name
                            </div>

                            <div class="info-value">
                                @Model.FullName
                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="info-label">
                                Email Address
                            </div>

                            <div class="info-value">
                                @Model.Email
                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="info-label">
                                Phone Number
                            </div>

                            <div class="info-value">

                                @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                    ? "Not provided"
                                    : Model.PhoneNumber)

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="info-label">
                                Profile Status
                            </div>

                            <div class="info-value">

                                @if (Model.ProfileComplete)
                                {
                                    <span class="text-success fw-semibold">

                                        <i class="bi bi-check-circle-fill me-1"></i>

                                        Complete

                                    </span>
                                }
                                else
                                {
                                    <span class="text-warning fw-semibold">

                                        <i class="bi bi-exclamation-circle-fill me-1"></i>

                                        Incomplete

                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- Important Information -->
        <!-- ===================================================== -->

        <div class="col-lg-4">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <div>

                        <h5 class="fw-bold mb-1">
                            Important Information
                        </h5>

                        <small class="text-muted">
                            Application guidance
                        </small>

                    </div>

                </div>


                <div class="dashboard-card-body">

                    <div class="notice-item">

                        <div class="notice-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div>

                            <div class="fw-semibold">
                                Keep your profile updated
                            </div>

                            <small class="text-muted">
                                Make sure your personal information
                                is accurate before submitting an application.
                            </small>

                        </div>

                    </div>


                    <div class="notice-item">

                        <div class="notice-icon">
                            <i class="bi bi-file-earmark-check"></i>
                        </div>

                        <div>

                            <div class="fw-semibold">
                                Prepare your documents
                            </div>

                            <small class="text-muted">
                                Required documents will be uploaded
                                during the application process.
                            </small>

                        </div>

                    </div>


                    <div class="notice-item mb-0">

                        <div class="notice-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>

                            <div class="fw-semibold">
                                Review before submission
                            </div>

                            <small class="text-muted">
                                Carefully check your information before
                                submitting your application.
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* =========================================================
       Welcome
       ========================================================= */

    .dashboard-welcome {
        background: linear-gradient(
            135deg,
            #ffffff 0%,
            #fff8fd 100%
        );

        border: 1px solid #ececf2;
        border-radius: 18px;
        padding: 28px 30px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 25px;

        box-shadow:
            0 4px 18px
            rgba(0, 0, 0, 0.04);
    }


    .welcome-icon {
        width: 48px;
        height: 48px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 13px;

        background: rgba(216, 0, 184, 0.10);
        color: #70461d;

        font-size: 21px;
    }


    .welcome-logo {
        width: 145px;
        text-align: right;
    }


    .welcome-logo img {
        max-height: 70px;
        width: auto;
    }


    /* =========================================================
       Profile Alert
       ========================================================= */

    .profile-alert {
        display: flex;
        align-items: center;
        gap: 15px;

        padding: 17px 20px;

        background: #fffaf0;
        border: 1px solid #f2dfb0;
        border-radius: 13px;
    }


    .profile-alert-icon {
        width: 42px;
        height: 42px;

        flex-shrink: 0;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 11px;

        background: #fff0c7;
        color: #a36a00;

        font-size: 19px;
    }


    /* =========================================================
       Summary Cards
       ========================================================= */

    .summary-card {
        height: 100%;

        background: #ffffff;

        border: 1px solid #ececf2;
        border-radius: 15px;

        padding: 20px;

        display: flex;
        align-items: center;
        gap: 16px;

        box-shadow:
            0 4px 14px
            rgba(0, 0, 0, 0.035);
    }


    .summary-icon {
        width: 48px;
        height: 48px;

        flex-shrink: 0;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        font-size: 21px;
    }


    .application-icon {
        background: rgba(216, 0, 184, 0.10);
        color: #70461d;
    }


    .document-icon {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }


    .payment-icon {
        background: rgba(25, 135, 84, 0.10);
        color: #198754;
    }


    .profile-icon {
        background: rgba(255, 193, 7, 0.13);
        color: #b98500;
    }


    .summary-label {
        color: #777c86;
        font-size: 13px;
        margin-bottom: 3px;
    }


    .summary-value {
        font-size: 18px;
        font-weight: 700;
        color: #292c34;
    }


    .summary-description {
        color: #969aa3;
        font-size: 12px;
        margin-top: 2px;
    }


    /* =========================================================
       Dashboard Cards
       ========================================================= */

    .dashboard-card {
        background: #ffffff;

        border: 1px solid #ececf2;
        border-radius: 16px;

        box-shadow:
            0 4px 16px
            rgba(0, 0, 0, 0.035);

        overflow: hidden;
    }


    .dashboard-card-header {
        padding: 18px 20px;

        border-bottom: 1px solid #eeeeF3;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;
    }


    .dashboard-card-body {
        padding: 22px;
    }


    /* =========================================================
       Status
       ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;

        border-radius: 30px;

        padding: 6px 11px;

        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }


    .status-not-started {
        background: #f1f2f4;
        color: #666b74;
    }


    /* =========================================================
       Empty State
       ========================================================= */

    .empty-state {
        text-align: center;
        padding: 28px 15px;
    }


    .empty-state-icon {
        width: 66px;
        height: 66px;

        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 18px;

        background: rgba(216, 0, 184, 0.08);
        color: #70461d;

        font-size: 28px;
    }


    /* =========================================================
       Quick Actions
       ========================================================= */

    .quick-actions {
        display: flex;
        flex-direction: column;
    }


    .quick-action {
        display: flex;
        align-items: center;
        gap: 13px;

        padding: 13px 10px;

        color: inherit;
        text-decoration: none;

        border-radius: 10px;

        transition:
            background 0.15s ease,
            transform 0.15s ease;
    }


    .quick-action:hover {
        background: #faf5f9;
        transform: translateX(2px);
        color: inherit;
    }


    .quick-action-icon {
        width: 39px;
        height: 39px;

        flex-shrink: 0;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: rgba(216, 0, 184, 0.08);
        color: #70461d;
    }


    .quick-action-content {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }


    .quick-action-content strong {
        font-size: 14px;
    }


    .quick-action-content small {
        color: #8a8e97;
        font-size: 12px;
        margin-top: 2px;
    }


    .quick-action > .bi-chevron-right {
        color: #a0a3aa;
        font-size: 13px;
    }


    /* =========================================================
       Applicant Information
       ========================================================= */

    .info-label {
        color: #858991;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }


    .info-value {
        color: #2d3038;
        font-weight: 600;
    }


    /* =========================================================
       Buttons
       ========================================================= */

    .btn-kism-primary {
        background: #70461d;
        border-color: #70461d;
        color: #ffffff;

        min-height: 42px;

        border-radius: 9px;

        font-weight: 600;

        box-shadow:
            0 4px 10px
            rgba(216, 0, 184, 0.16);
    }


    .btn-kism-primary:hover,
    .btn-kism-primary:focus {
        background: #70461d;
        border-color: #70461d;
        color: #ffffff;
    }


    .btn-outline-kism {
        color: #70461d;
        border-color: #70461d;
        border-radius: 8px;
        font-weight: 600;
    }


    .btn-outline-kism:hover,
    .btn-outline-kism:focus {
        background: #70461d;
        border-color: #70461d;
        color: #ffffff;
    }


    /* =========================================================
       Notices
       ========================================================= */

    .notice-item {
        display: flex;
        gap: 12px;

        padding-bottom: 18px;
        margin-bottom: 18px;

        border-bottom: 1px solid #eeeeF3;
    }


    .notice-icon {
        width: 36px;
        height: 36px;

        flex-shrink: 0;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 9px;

        background: rgba(216, 0, 184, 0.08);
        color: #70461d;
    }


    /* =========================================================
       Responsive
       ========================================================= */

    @@media (max-width: 767.98px) {

        .dashboard-welcome {
            padding: 22px;
        }


        .welcome-logo {
            display: none;
        }


        .profile-alert {
            align-items: flex-start;
            flex-wrap: wrap;
        }


        .profile-alert .btn {
            width: 100%;
        }


        .dashboard-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

    }

</style>