@{
    var title = ViewData["Title"] as string
        ?? "KISM Application Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@title - KISM Application Management System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --kism-primary: #70461d;
            --kism-primary-dark: #70461d;
            --kism-accent: #edff0f;
            --kism-background: #f6f7fb;
            --kism-text: #30323d;
            --kism-muted: #858999;
            --kism-border: #e7e8ef;
        }

        html {
            font-size: 14px;
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--kism-background);
            color: var(--kism-text);
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;
        }

        .kism-auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }

        .kism-auth-container {
            width: 100%;
            max-width: 480px;
        }

        .kism-auth-card {
            background: #ffffff;
            border: 1px solid var(--kism-border);
            border-radius: 18px;
            box-shadow: 0 12px 40px rgba(31, 35, 45, 0.10);
            padding: 35px;
        }

        .kism-auth-logo {
            display: block;
            width: 100%;
            max-width: 100%;
            height: auto;
            margin: 0 auto 30px;
            background: #ffffff;
            padding: 10px;
            border-radius: 10px;
        }

        .kism-auth-title {
            color: var(--kism-text);
            font-weight: 700;
            margin-bottom: 8px;
        }

        .kism-auth-subtitle {
            color: var(--kism-muted);
            margin-bottom: 25px;
        }

        .btn-kism-primary {
            background-color: var(--kism-primary);
            border-color: var(--kism-primary);
            color: #ffffff;
            font-weight: 600;
        }

        .btn-kism-primary:hover,
        .btn-kism-primary:focus,
        .btn-kism-primary:active {
            background-color: var(--kism-primary-dark) !important;
            border-color: var(--kism-primary-dark) !important;
            color: #ffffff !important;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--kism-primary);
            box-shadow: 0 0 0 0.2rem rgba(216, 0, 184, 0.15);
        }

        .form-check-input:checked {
            background-color: var(--kism-primary);
            border-color: var(--kism-primary);
        }

        a {
            color: var(--kism-primary);
        }

        a:hover {
            color: var(--kism-primary-dark);
        }

        .kism-auth-footer {
            margin-top: 20px;
            text-align: center;
            color: var(--kism-muted);
            font-size: 0.85rem;
        }

        .kism-validation-summary {
            border-radius: 10px;
        }

        @@media (max-width: 575.98px) {
            .kism-auth-page {
                padding: 20px 12px;
            }

            .kism-auth-card {
                padding: 25px 20px;
                border-radius: 14px;
            }

            .kism-auth-logo {
                margin-bottom: 25px;
            }
        }
    </style>
</head>

<body>

    <main class="kism-auth-page">
        <div class="kism-auth-container">

            <div class="kism-auth-card">

                @RenderBody()

            </div>

            <div class="kism-auth-footer">
                &copy; @DateTime.Now.Year
                Kenya Institute of Surveying and Mapping
            </div>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>